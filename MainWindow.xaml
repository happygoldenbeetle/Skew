<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Mori.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mori.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mori"
    mc:Ignorable="d">

    <!--
        Root layout: the entire browser chrome.
        3-column grid: [Sidebar] | [Web Content Card] | [AI Panel]
        The web content sits in a floating rounded card inset from the edges (Arc-style).
    -->
    <Grid x:Name="RootGrid" Background="Transparent" SizeChanged="RootGrid_SizeChanged">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <RepositionThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Accelerator_GoBack" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="Accelerator_GoForward" />
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions>
            <!-- Sidebar column — auto width, collapses when hidden -->
            <ColumnDefinition x:Name="SidebarColumn" Width="256" />
            <!-- Web content — fills remaining space -->
            <ColumnDefinition Width="*" />
            <!--  AI Panel column  -->
            <ColumnDefinition x:Name="AIPanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Film Grain Overlay Removed -->
        <!-- ═══ Sidebar (docked / visible state) ═══ -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Margin="0">
            <controls:MoriSidebar x:Name="Sidebar" />
        </Border>

        <!-- ═══ Web Content Area ═══ -->
        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <!-- Loading bar strip -->
                <RowDefinition Height="Auto" />
                <!-- Web card -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Loading progress bar (top edge, Arc-style) -->
            <ProgressBar
                x:Name="LoadingBar"
                Grid.Row="0"
                Height="2.5"
                IsIndeterminate="True"
                Visibility="Collapsed" />

            <!-- Floating web content card with rounded corners and shadow -->
            <Border
                x:Name="WebContentBorder"
                Grid.Row="1"
                Margin="4"
                SizeChanged="WebContentBorder_SizeChanged"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Shadow="{ThemeResource SharedShadow}">

                <!-- Web content placeholder — will host CEF HWND later -->
                <Grid
                    x:Name="WebContentHost"
                    CornerRadius="10">
                    <!-- Placeholder content showing we're alive -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE774;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Mori" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Web content will appear here" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Find bar overlay (top-right of web card) -->
            <controls:MoriFindBar
                x:Name="FindBar"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,20,0"
                Visibility="{x:Bind Store.FindBarVisible, Mode=OneWay}" />

            <!-- ═══ Launcher Overlay (command palette) ═══ -->
            <Popup x:Name="LauncherPopup" Grid.Row="1" Margin="4" IsOpen="False" ShouldConstrainToRootBounds="False">
                <controls:MoriLauncher x:Name="Launcher" />
            </Popup>

            <!-- ═══ Swipe Gesture Overlay ═══ -->
            <Popup x:Name="SwipePopup" Grid.Row="1" Margin="4" IsOpen="False" IsHitTestVisible="False" ShouldConstrainToRootBounds="False">
                <controls:SwipeIndicatorOverlay x:Name="SwipeOverlay" />
            </Popup>
        </Grid>


        <!-- ═══ AI Panel ═══ -->
        <controls:MoriAIPanel
            x:Name="AIPanel"
            Grid.Column="2"
            Visibility="Collapsed" />

        <!-- Sidebar reveal button (shows when sidebar is hidden) -->
        <Button
            x:Name="SidebarRevealButton"
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="16,16,0,0"
            Width="32" Height="32"
            Padding="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Click="SidebarReveal_Click"
            Visibility="Collapsed"
            ToolTipService.ToolTip="Show Sidebar (Ctrl+S)">
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
            <PathIcon x:Name="SidebarRevealButtonIcon" Data="F1 M 9.16667 5.5 a 0.5 0.5 0 0 1 0 1 h -1 a 0.5 0.5 0 0 1 0 -1 z M 9.16667 3.66667 a 0.5 0.5 0 0 1 0 1 h -1 a 0.5 0.5 0 0 1 0 -1 z M 9.5 1.33333 A 1.83333 1.83333 0 0 1 11.3333 3.16667 v 5.66667 A 1.83333 1.83333 0 0 1 9.5 10.6667 H 2.5 A 1.83333 1.83333 0 0 1 0.666667 8.83333 v -5.66667 A 1.83333 1.83333 0 0 1 2.5 1.33333 z M 2.5 2.33333 c -0.46 0 -0.833333 0.373333 -0.833333 0.833333 v 5.66667 c 0 0.46 0.373333 0.833333 0.833333 0.833333 H 6 v -7.33333 z m 4.5 7.33333 h 2.5 c 0.46 0 0.833333 -0.373333 0.833333 -0.833333 v -5.66667 c 0 -0.46 -0.373333 -0.833333 -0.833333 -0.833333 H 7 z" Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                <PathIcon.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </PathIcon.RenderTransform>
            </PathIcon>
        </Button>

        <!-- Top Drag Area (Double-click to Maximize) -->
        <Grid Grid.ColumnSpan="3" Height="12" VerticalAlignment="Top" Background="Transparent" DoubleTapped="TopDragArea_DoubleTapped" ToolTipService.ToolTip="Double-click to maximize" />

        <!-- ═══ Sidebar Peek (mac-style floating overlay) ═══ -->
        <!--
            The live CEF browser is hosted in a native child HWND that composites
            ABOVE all XAML, so a normal in-grid overlay would render behind the
            page (the same airspace problem mac solves with an AppKit hosting
            view). A Popup with ShouldConstrainToRootBounds=False is the only
            surface that floats above the CEF window, so the peek sidebar lives
            here. The popup is pre-warmed (opened once, kept open) to avoid the
            first-open lag; the card is just slid off-screen when idle.

            The host has a null background so empty areas stay click-through to
            the page; only the edge trigger strip and the floating card are
            hit-testable (mac's hitTest gating).
        -->
        <Popup x:Name="SidebarPeekPopup" ShouldConstrainToRootBounds="False">
            <Grid x:Name="PeekHost" Width="300" Background="{x:Null}" Visibility="Collapsed">
                <!-- Edge trigger strip: hovering the window edge slides the peek in -->
                <Border x:Name="PeekEdgeStrip"
                        Width="12"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        PointerEntered="PeekEdgeStrip_PointerEntered"
                        PointerExited="PeekEdgeStrip_PointerExited" />

                <!-- Resting hint: a faint capsule that morphs into a chevron on peek -->
                <Grid x:Name="PeekEdgeHandle"
                      Width="18" Height="44"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PeekHandleTranslate" X="-6" />
                    </Grid.RenderTransform>
                    <Rectangle x:Name="PeekHandleCapsule"
                               Width="4" Height="40"
                               RadiusX="2" RadiusY="2"
                               Fill="{ThemeResource TextFillColorPrimaryBrush}"
                               Opacity="0.22" />
                    <FontIcon x:Name="PeekHandleChevron"
                              Glyph="&#xE76B;"
                              FontSize="14"
                              Opacity="0"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Grid>

                <!-- Floating sidebar card -->
                <Border x:Name="SidebarPeekCard"
                        Width="256"
                        Margin="0,8,8,8"
                        HorizontalAlignment="Right"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Shadow="{ThemeResource SharedShadow}"
                        PointerEntered="SidebarPeekCard_PointerEntered"
                        PointerExited="SidebarPeekCard_PointerExited">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PeekCardTranslate" X="280" />
                    </Border.RenderTransform>
                    <controls:MoriSidebar x:Name="PeekSidebar" />
                </Border>
            </Grid>
        </Popup>

        <!-- ═══ Settings Flyout ═══ -->
        <Popup x:Name="SettingsPopup" IsOpen="{x:Bind Store.SettingsVisible, Mode=OneWay}" ShouldConstrainToRootBounds="False">
            <controls:MoriSettings x:Name="SettingsFlyout" />
        </Popup>
    </Grid>
</Window>
