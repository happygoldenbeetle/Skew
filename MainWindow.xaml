<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Mori.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mori.Controls"
    xmlns:models="using:Mori.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mori"
    mc:Ignorable="d">

    <!--
        Port of RootView.swift.

        Everything here is one XAML tree, including the layers that sit *over* the
        page. That is only possible because the browser renders offscreen now
        (see MoriBrowserView): while Chromium owned a child HWND it composited
        above all XAML, so the peek sidebar, launcher and settings each had to
        live in their own top-level Popup window, hand-raised with SetWindowPos
        and unable to share the window's material or blur the page behind them.
    -->
    <!-- Transparent, not unset: Mica needs something to show through, and empty
         chrome areas must still hit-test so window drag and hover work. -->
    <Grid x:Name="RootGrid" Background="Transparent"
          SizeChanged="RootGrid_SizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Accelerator_GoBack" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="Accelerator_GoForward" />
        </Grid.KeyboardAccelerators>

        <!--
            ═══ Unified chrome surface (RootView.swift .background) ═══
            One material behind everything, so the card's inset gaps and the
            sidebar share the exact same surface with no colour step between
            them. Mica supplies the behind-window blur (the NSVisualEffectView
            equivalent); ChromeTint carries the palette wash over it; the grain
            layer matches GrainOverlay.
        -->
        <Grid.RowDefinitions>
            <!-- Title bar -->
            <RowDefinition Height="Auto" />
            <!-- Everything else -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="ChromeSurface" Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle x:Name="ChromeTint" />
            <Image x:Name="ChromeGrain" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" />
        </Grid>

        <!--
            ═══ Title bar ═══
            The real one. The window keeps its system title bar and extends the
            content into it, so Windows draws the caption buttons and owns drag,
            double-click to maximise, snap layouts and the Alt+Space menu. This
            grid is what SetTitleBar is handed as the drag region — hence the
            explicit Background, since a null one does not hit-test and the
            window would not drag.

            32 is TitleBarHeightOption.Standard, the height the system draws its
            buttons at (40px at 125%); any other value and the drag region and
            the buttons disagree about where the bar ends. The omnibox moves in
            here in a later pass.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <Grid.ColumnDefinitions>
                <!--
                    App icon and sidebar toggle. Held to the docked sidebar's
                    width by UpdateColumnLayout — and by the resize drag itself,
                    so the nav buttons after it start where the page starts and
                    travel with the sidebar's edge as it is dragged. Auto when
                    there is no sidebar on this side to line up with.
                -->
                <ColumnDefinition x:Name="TitleBarSidebarColumn" Width="Auto" />
                <!-- Back, forward, reload -->
                <ColumnDefinition Width="Auto" />
                <!-- Address, centred over what is left: the page -->
                <ColumnDefinition Width="*" />
                <!--
                    Held clear for the caption buttons. Sized from
                    AppWindow.TitleBar.RightInset rather than guessed, since how
                    much room the system takes is its business, not ours.
                -->
                <ColumnDefinition x:Name="CaptionButtonSpacer" Width="0" />
            </Grid.ColumnDefinitions>

            <!--
                Buttons inside the drag region are live: XAML hit-tests the
                interactive content of a SetTitleBar element and hands the rest
                to the window, so these click and the gaps between them drag.
            -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Spacing="2">

                <!--
                    The app mark: mori is a wood, so three trees. Drawn rather
                    than a font glyph, because no icon font ships one and the
                    stock project logo read as a broken image at this size.
                    Stretch fits the ink to the box, as everywhere else.
                -->
                <Path Data="F1 M 4,14 L 0.6,14 L 2.3,8.4 Z M 11.7,14 L 8.3,14 L 10,8.4 Z M 9.4,14 L 3.1,14 L 6.25,3.2 Z"
                      Stretch="Uniform"
                      Width="14.2" Height="14.2"
                      Margin="2,0,12,0"
                      VerticalAlignment="Center"
                      Fill="{ThemeResource TextFillColorPrimaryBrush}" />

                <Button x:Name="TitleBarSidebarToggle"
                        Width="30" Height="26"
                        Padding="0"
                        CornerRadius="6"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        Click="SidebarReveal_Click"
                        ToolTipService.ToolTip="Toggle Sidebar (Ctrl+S)">
                    <!--
                        The dock mark the context menu uses for the same idea,
                        pointed at the side the sidebar is on — UpdateColumnLayout
                        sets the glyph. The panel path it replaced had to be
                        mirrored by a transform to do the same job.
                    -->
                    <FontIcon x:Name="TitleBarSidebarToggleIcon"
                              Glyph="&#xE90C;"
                              FontSize="13.2" />
                </Button>
            </StackPanel>

            <!--
                Nav, starting where the page starts: this column follows the one
                before it, which is the sidebar's width while it is docked left.

                No left margin — the first button's box begins on the card's left
                edge exactly. What space is left before the glyph is the button
                centring its own icon, which is the hit area, not a gap.
            -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="2">

                <Button x:Name="TitleBarBack"
                        Width="30" Height="26" Padding="0" CornerRadius="6"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        Click="TitleBarBack_Click"
                        ToolTipService.ToolTip="Go back">
                    <!-- Back/Forward, the arrows, not ChevronLeft/Right. -->
                    <FontIcon Glyph="&#xE72B;" FontSize="13.2" />
                </Button>

                <Button x:Name="TitleBarForward"
                        Width="30" Height="26" Padding="0" CornerRadius="6"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        Click="TitleBarForward_Click"
                        ToolTipService.ToolTip="Go forward">
                    <FontIcon Glyph="&#xE72A;" FontSize="13.2" />
                </Button>

                <Button x:Name="TitleBarReload"
                        Width="30" Height="26" Padding="0" CornerRadius="6"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        Click="TitleBarReload_Click"
                        ToolTipService.ToolTip="Reload">
                    <FontIcon x:Name="TitleBarReloadIcon" Glyph="&#xE72C;" FontSize="13.2" />
                </Button>
            </StackPanel>

            <!--
                The address, host only — DisplayUrl on the tab already drops the
                scheme, the www and the path, which is the whole point of showing
                it here rather than a full URL.
            -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="2">

                <Button x:Name="TitleBarCopyLink"
                        Width="28" Height="26" Padding="0" CornerRadius="6"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        Click="TitleBarCopyLink_Click"
                        ToolTipService.ToolTip="Copy link">
                    <FontIcon Glyph="&#xE71B;" FontSize="12.2" />
                </Button>

                <Button x:Name="TitleBarAddress"
                        Height="26" Padding="10,0" CornerRadius="6"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        Click="TitleBarAddress_Click"
                        ToolTipService.ToolTip="Search or enter address">
                    <TextBlock x:Name="TitleBarUrl"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>

                <Button x:Name="TitleBarPageOptions"
                        Width="28" Height="26" Padding="0" CornerRadius="6"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        ToolTipService.ToolTip="Options">
                    <!--
                        Sliders, drawn: the two-rails-and-knobs mark, which no
                        Segoe glyph matches — Filter is a funnel and Setting is a
                        gear, and neither says "adjust this page". Stroked, so
                        the rails and the knob outlines share one weight.
                    -->
                    <Path Data="M 1,5 L 15,5 M 1,11 L 15,11 M 8,5 A 2,2 0 1,1 12,5 A 2,2 0 1,1 8,5 M 4,11 A 2,2 0 1,1 8,11 A 2,2 0 1,1 4,11"
                          Stretch="Uniform"
                          Width="12.2" Height="12.2"
                          Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                          StrokeThickness="0.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />

                    <!--
                        ═══ Page options popover ═══
                        What the sliders mark has always promised: the controls
                        that act on the page in front of you, not the sidebar
                        menu it used to borrow. Share, the extensions that can
                        run here, the one media behaviour worth a switch, and —
                        under the overflow, where the destructive and the rarely
                        wanted belong — the site's data and settings.
                    -->
                    <Button.Flyout>
                        <Flyout x:Name="PageOptionsFlyout"
                                Placement="Bottom"
                                ShouldConstrainToRootBounds="False"
                                Opened="PageOptionsFlyout_Opened">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MaxWidth" Value="1000" />
                                    <!--
                                        Opaque. The stock presenter is acrylic,
                                        which dragged the page and the Mica
                                        grain up through the popover and left
                                        the text sitting on whatever happened to
                                        be behind the window.
                                    -->
                                    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
                                    <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <StackPanel Width="302" Padding="10,10,10,8" Spacing="8">

                                <!-- Share, the one thing here that acts on the URL itself. -->
                                <Button x:Name="PageOptionsShare"
                                        Height="38"
                                        CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="PageOptionsShare_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72D;" FontSize="14" />
                                        <TextBlock x:Name="PageOptionsShareLabel"
                                                   Text="Share URL"
                                                   FontSize="13.5"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Margin="0,2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!--
                                    Extensions: the installed ones as chips, then
                                    the add control — the same shape the omnibox
                                    menu uses, at the size a row of icons wants.
                                -->
                                <TextBlock Text="Extensions"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ItemsControl x:Name="PageOptionsExtensions">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:BrowserExtension">
                                                <Button Width="30" Height="30" Padding="0"
                                                        CornerRadius="8"
                                                        Style="{StaticResource MoriGhostButtonStyle}"
                                                        Tag="{x:Bind Id}"
                                                        ToolTipService.ToolTip="{x:Bind Name}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE71D;" FontSize="13"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Image Source="{x:Bind IconImage}"
                                                               Width="18" Height="18"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button x:Name="PageOptionsWebStore"
                                            Width="30" Height="30" Padding="0"
                                            CornerRadius="8"
                                            Style="{StaticResource MoriGhostButtonStyle}"
                                            Click="PageOptionsWebStore_Click"
                                            ToolTipService.ToolTip="Get extensions from the Chrome Web Store">
                                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    </Button>
                                </StackPanel>

                                <Border Height="1" Margin="0,2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!-- Automatic Picture-In-Picture, the settings toggle brought to the page. -->
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Automatic Picture-In-Picture"
                                               FontSize="13.5"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- No On/Off text: the switch is the label's answer. -->
                                    <ToggleSwitch x:Name="PageOptionsAutoPiP"
                                                  Grid.Column="1"
                                                  MinWidth="0"
                                                  OnContent="" OffContent=""
                                                  VerticalAlignment="Center"
                                                  Toggled="PageOptionsAutoPiP_Toggled" />
                                </Grid>

                                <Border Height="1" Margin="0,2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!-- Footer: what the connection is, and the overflow. -->
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="PageOptionsSecurityChip"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="PageOptionsSecurityIcon"
                                                      Glyph="&#xE72E;" FontSize="11"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="PageOptionsSecurityLabel"
                                                       Text="Secure"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Button Grid.Column="1"
                                            Width="30" Height="26" Padding="0"
                                            CornerRadius="6"
                                            Style="{StaticResource MoriGhostButtonStyle}"
                                            ToolTipService.ToolTip="More">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <!--
                                                Glyphs, as the tab and sidebar
                                                menus carry. AlignedLeft pins
                                                the menu's left edge to the
                                                button's, so it opens rightward
                                                into the window rather than back
                                                across the popover it came from.
                                            -->
                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                <MenuFlyout.MenuFlyoutPresenterStyle>
                                                    <Style TargetType="MenuFlyoutPresenter">
                                                        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
                                                        <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
                                                    </Style>
                                                </MenuFlyout.MenuFlyoutPresenterStyle>
                                                <MenuFlyoutItem Text="Clear Cache" Click="PageOptionsClearCache_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE894;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Clear Cookies" Click="PageOptionsClearCookies_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Manage Extensions" Click="PageOptionsManageExtensions_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE71D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Add Extension" Click="PageOptionsAddExtension_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE710;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="All Site Settings" Click="PageOptionsSiteSettings_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE713;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--
            ═══ Main columns: [Sidebar] | [Web card] | [Sidebar] ═══
            Two side columns for one sidebar: it occupies whichever matches the
            side it is docked to, and the other stays at zero. Kept as two rather
            than moving one column about, so the card between them never has to
            change which column it is in.
        -->
        <Grid x:Name="ColumnsGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="256" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBorder" Grid.Column="0">
                <controls:MoriSidebar x:Name="Sidebar" />
            </Border>

            <!--
                Resize gripper: a thin strip on the sidebar's page-facing edge,
                inside the sidebar's own column so none of it covers the page —
                overhanging it stole clicks from the page's left edge. Declared
                after SidebarBorder so it sits above the sidebar's content, and
                moved to whichever column the sidebar occupies by
                UpdateColumnLayout. The width it sets is persisted.

                LineInset 0 hands the vertical extent entirely to the grip's own
                margin, which UpdateColumnLayout matches to the web card, so the
                indicator begins and ends level with the card's top and bottom
                edges instead of running the full height of the column.
            -->
            <controls:ResizeGrip x:Name="SidebarResizeGrip"
                    Grid.Column="0"
                    Width="6"
                    LineInset="0"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Visibility="Collapsed"
                    PointerPressed="SidebarResizeGrip_PointerPressed"
                    PointerMoved="SidebarResizeGrip_PointerMoved"
                    PointerReleased="SidebarResizeGrip_PointerReleased"
                    PointerCaptureLost="SidebarResizeGrip_PointerReleased" />

            <!-- ═══ Web content column ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ProgressBar
                    x:Name="LoadingBar"
                    Grid.Row="0"
                    Height="2.5"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <Grid x:Name="WebCardArea" Grid.Row="1">
                    <!--
                        The hover-revealed strip that used to sit behind the card
                        is gone with TopChrome.swift's reveal: the title bar is a
                        real one at the top of the window now, always there, so
                        there is nothing to slide the card down for.
                    -->

                    <!--
                        The floating card (RootView.webCard). Insets and hairline
                        border are the Mac values — sides and bottom 8, border at
                        0.7 opacity — but the radius is 4 rather than the Mac's
                        Radius.window of 10: at this card's size the Mac value
                        read as a visibly rounder page than anything around it.
                        Tighter than the sidebar's 6 on purpose — the page is a
                        far larger surface, and the same radius on it looks
                        rounder than it does on a tab row.

                        The top inset is 0, so the card meets the title bar. The
                        side inset here is the starting value; UpdateColumnLayout
                        owns it from then on, and zeroes the side a docked sidebar
                        is on so the card's inset and the sidebar's padding stop
                        stacking into a gap half again as wide as the one at the
                        window edge.
                    -->
                    <Border
                        x:Name="WebContentBorder"
                        Margin="8,0,8,8"
                        SizeChanged="WebContentBorder_SizeChanged"
                        BorderThickness="1"
                        CornerRadius="4"
                        Shadow="{ThemeResource SharedShadow}">
                        <!--
                            Same radius again, not inherited: the Border's radius
                            clips the live page to the card, and a host on a larger
                            radius would square the page's own corners off inside it.
                        -->
                        <Grid x:Name="WebContentHost" CornerRadius="4" />
                    </Border>

                    <!-- Find bar, over the card (RootView webCard .overlay topTrailing) -->
                    <controls:MoriFindBar
                        x:Name="FindBar"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,12,20,0"
                        Visibility="{x:Bind Store.FindBarVisible, Mode=OneWay}" />
                </Grid>
            </Grid>

        </Grid>


        <!--
            No floating reveal button here any more. It existed because a hidden
            sidebar left nothing on screen to bring it back with; the title bar
            carries a toggle at all times now, so in peek mode the two stacked
            one over the other in the same corner.

            The drag region went with the same change: it is AppTitleBar, handed
            to SetTitleBar, rather than a strip floating over the page.
        -->

        <!--
            ═══ Sidebar peek (SidebarPeek.swift) ═══
            A plain overlay now. It floats above the page without reflowing it,
            and because it is in the same visual tree as everything else it can
            be genuinely translucent over the live page — the separate popup
            window it used to live in could only ever be opaque.
        -->
        <!--
            Hidden by opacity, never by Visibility. A collapsed subtree is not
            laid out, and an ItemsRepeater inside one realizes no items at all —
            so the peek's pinned tiles and folders came up blank until some
            interaction forced a layout pass and they popped in. At Opacity 0 the
            host still measures, so its repeaters are populated before it is ever
            shown. IsHitTestVisible keeps it from swallowing clicks meanwhile.
        -->
        <Grid x:Name="PeekHost" Grid.Row="1" Width="268" HorizontalAlignment="Right"
              Opacity="0" IsHitTestVisible="False">
            <Border x:Name="PeekEdgeStrip"
                    Width="12"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    PointerEntered="PeekEdgeStrip_PointerEntered"
                    PointerExited="PeekEdgeStrip_PointerExited" />

            <!--
                No handle on the edge. A sidebar that comes out when the pointer
                reaches the edge is a convention every browser shares, so the
                capsule and chevron were labelling something already understood.
                PeekEdgeStrip above is what actually triggers it, and it is
                invisible by design.
            -->

            <!--
                Fully opaque: the card is hidden by being translated out of the
                window, not by fading. It starts non-hit-testable so the closed
                card cannot intercept the edge-strip hover; AnimatePeek flips
                that as it opens.
            -->
            <Border x:Name="SidebarPeekCard"
                    Width="224"
                    IsHitTestVisible="False"
                    Margin="0,8,8,8"
                    HorizontalAlignment="Right"
                    CornerRadius="6"
                    BorderThickness="1"
                    Shadow="{ThemeResource SharedShadow}"
                    PointerEntered="SidebarPeekCard_PointerEntered"
                    PointerExited="SidebarPeekCard_PointerExited">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PeekCardTranslate" X="280" />
                </Border.RenderTransform>
                <Grid>
                    <!--
                        10 above the first row, matching the sides. The docked
                        copy runs at 0 so its pins meet the title bar with the
                        web card; inside a floating card that same 0 puts the
                        tiles against the card's own top edge.
                    -->
                    <controls:MoriSidebar x:Name="PeekSidebar" TopInset="10" />

                    <!--
                        Inside the card, not beside it: the card slides in and
                        out on a transform, and a grip parked outside would sit
                        in the page while the card was closed. LayoutPeek puts it
                        on whichever edge faces the page.
                    -->
                    <controls:ResizeGrip x:Name="PeekResizeGrip"
                            Width="6"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            PointerPressed="PeekResizeGrip_PointerPressed"
                            PointerMoved="PeekResizeGrip_PointerMoved"
                            PointerReleased="PeekResizeGrip_PointerReleased"
                            PointerCaptureLost="PeekResizeGrip_PointerReleased" />
                </Grid>
            </Border>
        </Grid>

        <!--
            ═══ Launcher / command palette (LauncherOverlay.swift) ═══
            Centred over the whole window with a scrim that dims the live page
            behind it, exactly as on the Mac.
        -->
        <!--
            Row 1, like the other overlays: the launcher's scrim stops at the
            title bar rather than dimming it, which keeps the window draggable
            and its caption buttons live while the palette is open.
        -->
        <Grid x:Name="LauncherHost" Grid.Row="1" Visibility="Collapsed">
            <Rectangle x:Name="LauncherScrim" Fill="#000000" Opacity="0" Tapped="LauncherScrim_Tapped" />
            <controls:MoriLauncher x:Name="Launcher"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
        </Grid>

        <!-- ═══ Swipe gesture indicator ═══ -->
        <controls:SwipeIndicatorOverlay x:Name="SwipeOverlay"
                                        Grid.Row="1"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />

        <!-- ═══ Settings ═══ -->
        <Grid x:Name="SettingsHost" Grid.Row="1" Visibility="Collapsed">
            <Rectangle x:Name="SettingsScrim" Fill="#000000" Opacity="0.35" Tapped="SettingsScrim_Tapped" />
            <controls:MoriSettings x:Name="SettingsFlyout"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
