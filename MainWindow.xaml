<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Mori.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mori.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mori"
    mc:Ignorable="d">

    <!--
        Port of RootView.swift.

        Everything here is one XAML tree, including the layers that sit *over* the
        page. That is only possible because the browser renders offscreen now
        (see MoriBrowserView): while Chromium owned a child HWND it composited
        above all XAML, so the peek sidebar, launcher and settings each had to
        live in their own top-level Popup window, hand-raised with SetWindowPos
        and unable to share the window's material or blur the page behind them.
    -->
    <!-- Transparent, not unset: Mica needs something to show through, and empty
         chrome areas must still hit-test so window drag and hover work. -->
    <Grid x:Name="RootGrid" Background="Transparent"
          SizeChanged="RootGrid_SizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Accelerator_GoBack" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="Accelerator_GoForward" />
        </Grid.KeyboardAccelerators>

        <!--
            ═══ Unified chrome surface (RootView.swift .background) ═══
            One material behind everything, so the card's inset gaps and the
            sidebar share the exact same surface with no colour step between
            them. Mica supplies the behind-window blur (the NSVisualEffectView
            equivalent); ChromeTint carries the palette wash over it; the grain
            layer matches GrainOverlay.
        -->
        <Grid x:Name="ChromeSurface" IsHitTestVisible="False">
            <Rectangle x:Name="ChromeTint" />
            <Image x:Name="ChromeGrain" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" />
        </Grid>

        <!-- ═══ Main columns: [Sidebar] | [Web card] | [AI / extension panel] ═══ -->
        <Grid x:Name="ColumnsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="256" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AIPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBorder" Grid.Column="0">
                <controls:MoriSidebar x:Name="Sidebar" />
            </Border>

            <!--
                Resize gripper: a thin strip on the sidebar's page-facing edge.
                Declared after SidebarBorder so it sits above the sidebar's own
                content, and moved to whichever column the sidebar occupies by
                UpdateColumnLayout. The width it sets is persisted.
            -->
            <controls:ResizeGrip x:Name="SidebarResizeGrip"
                    Grid.Column="0"
                    Width="6"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Visibility="Collapsed"
                    PointerPressed="SidebarResizeGrip_PointerPressed"
                    PointerMoved="SidebarResizeGrip_PointerMoved"
                    PointerReleased="SidebarResizeGrip_PointerReleased"
                    PointerCaptureLost="SidebarResizeGrip_PointerReleased" />

            <!-- ═══ Web content column ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ProgressBar
                    x:Name="LoadingBar"
                    Grid.Row="0"
                    Height="2.5"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <Grid x:Name="WebCardArea" Grid.Row="1">
                    <!--
                        ═══ Revealed titlebar (TopChrome.swift) ═══
                        Sits behind the card. Hovering the top edge slides the card
                        down by TopChromeRevealHeight to expose this strip, then
                        slides it back. The card moves by transform and is never
                        resized, so the page never reflows.

                        The Mac fades in the real traffic lights here. This window
                        has no system titlebar (SetBorderAndTitleBar(true, false)),
                        so the caption buttons are ours to draw.
                    -->
                    <Grid x:Name="TopChromeStrip"
                          Height="28"
                          VerticalAlignment="Top"
                          Background="Transparent"
                          Opacity="0"
                          IsHitTestVisible="False"
                          DoubleTapped="TopDragArea_DoubleTapped"
                          ToolTipService.ToolTip="Double-click to maximize">
                        <TextBlock x:Name="TopChromeTitle"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.75"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Spacing="2">
                            <Button x:Name="CaptionMinimize"
                                    Style="{StaticResource MoriGhostButtonStyle}"
                                    Width="34" Height="22"
                                    Click="CaptionMinimize_Click"
                                    ToolTipService.ToolTip="Minimize">
                                <FontIcon Glyph="&#xE921;" FontSize="10"
                                          FontFamily="Segoe Fluent Icons" />
                            </Button>
                            <Button x:Name="CaptionMaximize"
                                    Style="{StaticResource MoriGhostButtonStyle}"
                                    Width="34" Height="22"
                                    Click="CaptionMaximize_Click"
                                    ToolTipService.ToolTip="Maximize">
                                <FontIcon x:Name="CaptionMaximizeIcon" Glyph="&#xE922;" FontSize="10"
                                          FontFamily="Segoe Fluent Icons" />
                            </Button>
                            <Button x:Name="CaptionClose"
                                    Style="{StaticResource MoriGhostButtonStyle}"
                                    Width="34" Height="22"
                                    Click="CaptionClose_Click"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE8BB;" FontSize="10"
                                          FontFamily="Segoe Fluent Icons" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--
                        The floating rounded card (RootView.webCard). Insets, radius
                        and hairline border are the Mac values: padding top 4 / sides
                        8 / bottom 8, Radius.window = 10, border at 0.7 opacity.

                        The side inset here is the starting value; UpdateColumnLayout
                        owns it from then on, and zeroes the side a docked sidebar is
                        on so the card's inset and the sidebar's padding stop stacking
                        into a gap half again as wide as the one at the window edge.
                    -->
                    <Border
                        x:Name="WebContentBorder"
                        Margin="8,4,8,8"
                        SizeChanged="WebContentBorder_SizeChanged"
                        BorderThickness="1"
                        CornerRadius="10"
                        Shadow="{ThemeResource SharedShadow}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="WebCardTranslate" />
                        </Border.RenderTransform>

                        <!-- CornerRadius on the Border clips the live page to the card. -->
                        <Grid x:Name="WebContentHost" CornerRadius="10" />
                    </Border>

                    <!-- Find bar, over the card (RootView webCard .overlay topTrailing) -->
                    <controls:MoriFindBar
                        x:Name="FindBar"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,12,20,0"
                        Visibility="{x:Bind Store.FindBarVisible, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- ═══ AI panel ═══ -->
            <controls:MoriAIPanel
                x:Name="AIPanel"
                Grid.Column="2"
                Visibility="Collapsed" />
        </Grid>

        <!-- Sidebar reveal button (shown when the sidebar is hidden) -->
        <Button
            x:Name="SidebarRevealButton"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="16,16,0,0"
            Width="32" Height="32"
            Padding="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Click="SidebarReveal_Click"
            Visibility="Collapsed"
            ToolTipService.ToolTip="Show Sidebar (Ctrl+S)">
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
            <PathIcon x:Name="SidebarRevealButtonIcon" Data="F1 M 9.16667 5.5 a 0.5 0.5 0 0 1 0 1 h -1 a 0.5 0.5 0 0 1 0 -1 z M 9.16667 3.66667 a 0.5 0.5 0 0 1 0 1 h -1 a 0.5 0.5 0 0 1 0 -1 z M 9.5 1.33333 A 1.83333 1.83333 0 0 1 11.3333 3.16667 v 5.66667 A 1.83333 1.83333 0 0 1 9.5 10.6667 H 2.5 A 1.83333 1.83333 0 0 1 0.666667 8.83333 v -5.66667 A 1.83333 1.83333 0 0 1 2.5 1.33333 z M 2.5 2.33333 c -0.46 0 -0.833333 0.373333 -0.833333 0.833333 v 5.66667 c 0 0.46 0.373333 0.833333 0.833333 0.833333 H 6 v -7.33333 z m 4.5 7.33333 h 2.5 c 0.46 0 0.833333 -0.373333 0.833333 -0.833333 v -5.66667 c 0 -0.46 -0.373333 -0.833333 -0.833333 -0.833333 H 7 z" Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                <PathIcon.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </PathIcon.RenderTransform>
            </PathIcon>
        </Button>

        <!--
            The window drag region lives inside TopChromeStrip, not as a strip
            floating over everything: a sibling strip at the top swallowed the
            pointer before the hover tracker could see it, so the reveal never
            fired. On the Mac the tracker is a pure hover watcher whose hitTest
            always passes through, and the titlebar only becomes interactive once
            revealed — same behaviour here.
        -->

        <!--
            ═══ Sidebar peek (SidebarPeek.swift) ═══
            A plain overlay now. It floats above the page without reflowing it,
            and because it is in the same visual tree as everything else it can
            be genuinely translucent over the live page — the separate popup
            window it used to live in could only ever be opaque.
        -->
        <!--
            Hidden by opacity, never by Visibility. A collapsed subtree is not
            laid out, and an ItemsRepeater inside one realizes no items at all —
            so the peek's pinned tiles and folders came up blank until some
            interaction forced a layout pass and they popped in. At Opacity 0 the
            host still measures, so its repeaters are populated before it is ever
            shown. IsHitTestVisible keeps it from swallowing clicks meanwhile.
        -->
        <Grid x:Name="PeekHost" Width="268" HorizontalAlignment="Right"
              Opacity="0" IsHitTestVisible="False">
            <Border x:Name="PeekEdgeStrip"
                    Width="12"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    PointerEntered="PeekEdgeStrip_PointerEntered"
                    PointerExited="PeekEdgeStrip_PointerExited" />

            <Grid x:Name="PeekEdgeHandle"
                  Width="18" Height="44"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PeekHandleTranslate" X="-6" />
                </Grid.RenderTransform>
                <Rectangle x:Name="PeekHandleCapsule"
                           Width="4" Height="40"
                           RadiusX="2" RadiusY="2"
                           Fill="{ThemeResource TextFillColorPrimaryBrush}"
                           Opacity="0.22" />
                <FontIcon x:Name="PeekHandleChevron"
                          Glyph="&#xE76B;"
                          FontSize="14"
                          Opacity="0"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Grid>

            <!--
                Fully opaque: the card is hidden by being translated out of the
                window, not by fading. It starts non-hit-testable so the closed
                card cannot intercept the edge-strip hover; AnimatePeek flips
                that as it opens.
            -->
            <Border x:Name="SidebarPeekCard"
                    Width="224"
                    IsHitTestVisible="False"
                    Margin="0,8,8,8"
                    HorizontalAlignment="Right"
                    CornerRadius="10"
                    BorderThickness="1"
                    Shadow="{ThemeResource SharedShadow}"
                    PointerEntered="SidebarPeekCard_PointerEntered"
                    PointerExited="SidebarPeekCard_PointerExited">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PeekCardTranslate" X="280" />
                </Border.RenderTransform>
                <controls:MoriSidebar x:Name="PeekSidebar" />
            </Border>
        </Grid>

        <!--
            ═══ Launcher / command palette (LauncherOverlay.swift) ═══
            Centred over the whole window with a scrim that dims the live page
            behind it, exactly as on the Mac.
        -->
        <Grid x:Name="LauncherHost" Visibility="Collapsed">
            <Rectangle x:Name="LauncherScrim" Fill="#000000" Opacity="0" Tapped="LauncherScrim_Tapped" />
            <controls:MoriLauncher x:Name="Launcher"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
        </Grid>

        <!-- ═══ Swipe gesture indicator ═══ -->
        <controls:SwipeIndicatorOverlay x:Name="SwipeOverlay"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />

        <!-- ═══ Settings ═══ -->
        <Grid x:Name="SettingsHost" Visibility="Collapsed">
            <Rectangle x:Name="SettingsScrim" Fill="#000000" Opacity="0.35" Tapped="SettingsScrim_Tapped" />
            <controls:MoriSettings x:Name="SettingsFlyout"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
