<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriLauncher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <!-- Full-window scrim + centered card (Spotlight-style command palette) -->
    <Grid Background="#40000000" PointerPressed="Scrim_PointerPressed">
        <Border
            MaxWidth="620"
            Margin="24,80,24,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            PointerPressed="Card_PointerPressed"
            Shadow="{ThemeResource SharedShadow}">
            <StackPanel>
                <!-- Header: icon + search field + zoom label -->
                <Grid Padding="16,0" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        FontSize="17"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE774;" />

                    <FontIcon
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        FontSize="15"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE721;" />

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="15"
                        PlaceholderText="Search…"
                        KeyDown="SearchBox_KeyDown" />

                    <Border
                        Grid.Column="3"
                        Padding="7,3"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="100%" />
                    </Border>
                </Grid>

                <!-- Separator -->
                <Border
                    Height="1"
                    Margin="14,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.45" />

                <!-- Results list -->
                <ListView
                    x:Name="ResultsList"
                    MaxHeight="280"
                    Padding="6"
                    SelectionMode="Single"
                    ItemClick="Result_Click"
                    IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46" Padding="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <muxc:PersonPicture
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    Margin="0,0,10,0"
                                    DisplayName="{Binding Title}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding DisplayUrl}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
