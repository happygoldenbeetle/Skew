<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriLauncher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Name="RevealAnimation">
            <DoubleAnimation Storyboard.TargetName="ScrimGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1" />
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1" />
        </Storyboard>
        <Storyboard x:Name="HideAnimation" Completed="HideAnimation_Completed">
            <DoubleAnimation Storyboard.TargetName="ScrimGrid" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
        </Storyboard>
    </UserControl.Resources>

    <!--
        Centered card, no scrim. The dimming wash is gone at the user's
        request; the layer stays, transparent, because it is still what
        catches a click outside the card and dismisses it — and a
        transparent background hit-tests where a null one does not.

        Sizes below are DIPs. The design is in pixels at 125%, so each
        figure is that pixel value over 1.25: 900px card, 65px field,
        60px rows, 30px favicons.
    -->
    <Grid x:Name="ScrimGrid" Background="Transparent" CornerRadius="10" PointerPressed="Scrim_PointerPressed">
        <Border
            x:Name="Card"
            RenderTransformOrigin="0.5,0.5"
            Width="720"
            Margin="24,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#090A09"
            BorderBrush="#676D6E"
            BorderThickness="1"
            CornerRadius="12"
            PointerPressed="Card_PointerPressed"
            Shadow="{ThemeResource SharedShadow}"
            Translation="0,0,32">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <StackPanel>
                <!-- Header: icon + search field + zoom label. 65px at 125%. -->
                <Grid Padding="16,0" Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The glass alone. The app mark that used to sit beside it
                        said only what window you were in, which the window
                        already says.
                    -->
                    <PathIcon Grid.Column="1" Margin="0,0,12,0" Width="15" Height="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Data="F1 M 6.45833 1.25 A 5.20833 5.20833 0 0 1 11.6667 6.45833 a 5.18333 5.18333 0 0 1 -1.11167 3.2125 l 3.01167 3.0125 a 0.625 0.625 0 0 1 -0.883333 0.883333 l -3.0125 -3.01167 A 5.18333 5.18333 0 0 1 6.45833 11.6667 a 5.20833 5.20833 0 0 1 0 -10.4167 m 0 1.25 a 3.95833 3.95833 0 1 0 0 7.91667 3.95833 3.95833 0 0 0 0 -7.91667" />

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="15"
                        PlaceholderText="Search or Enter URL..."
                        KeyDown="SearchBox_KeyDown"
                        PreviewKeyDown="SearchBox_PreviewKeyDown"
                        TextChanged="SearchBox_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>
                </Grid>

                <!-- Separator -->
                <Border
                    Height="1"
                    Margin="14,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.45" />

                <!-- Results list -->
                <!--
                    No height of its own and no scrolling: the list is capped at
                    five rows in code, so it can size to its content and the
                    card grows and shrinks with it. A MaxHeight instead left a
                    scrollbar to appear the moment the rows and the padding
                    added up to more than the cap.
                -->
                <ListView
                    x:Name="ResultsList"
                    Padding="4,2"
                    SelectionMode="Single"
                    ItemClick="Result_Click"
                    IsItemClickEnabled="True"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.Resources>
                        <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                        <!--
                            One colour for hover, selection and press. The list
                            is keyboard-driven — the selected row moves with the
                            arrows while the pointer sits still — so a selection
                            wash that differs from the hover wash reads as two
                            rows both claiming to be next.
                        -->
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#181817" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#181817" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#181817" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#181817" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#181817" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <!--
                                2 above and 2 below, so the gap between two rows
                                is 4 — 5px at 125%. The list's own 4,2 padding
                                completes it: 4 to the card's sides, and 2+2 at
                                the ends so the outer gaps match the inner ones.
                            -->
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ListViewItemPresenter
                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                            Control.IsTemplateFocusTarget="True"
                                            FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                            FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                            FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                            FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                            FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                                            SelectionCheckMarkVisualEnabled="True"
                                            CheckBrush="{ThemeResource ListViewItemCheckBrush}"
                                            CheckBoxBrush="{ThemeResource ListViewItemCheckBoxBrush}"
                                            DragBackground="{ThemeResource ListViewItemDragBackground}"
                                            DragForeground="{ThemeResource ListViewItemDragForeground}"
                                            FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"
                                            FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"
                                            PlaceholderBackground="{ThemeResource ListViewItemPlaceholderBackground}"
                                            PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}"
                                            PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                            SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                                            SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                            SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"
                                            PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                                            SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelectedPressed}"
                                            DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                            DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}"
                                            ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            ContentMargin="{TemplateBinding Padding}"
                                            CheckMode="{ThemeResource ListViewItemCheckMode}"
                                            CornerRadius="{TemplateBinding CornerRadius}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- 60px row, 30px favicon, both at 125%. -->
                            <Grid Height="48" Padding="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Show PersonPicture for existing tabs -->
                                <muxc:PersonPicture
                                    Grid.Column="0"
                                    Width="24" Height="24"
                                    Margin="0,0,12,0"
                                    Visibility="{Binding TabIconVisibility}"
                                    DisplayName="{Binding Title}"
                                    ProfilePicture="{Binding TabFaviconSource}" />

                                <!-- Show Search Icon for Google Fallback -->
                                <FontIcon
                                    Grid.Column="0"
                                    Width="24" Height="24"
                                    Margin="0,0,12,0"
                                    Visibility="{Binding SearchIconVisibility}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE721;"
                                    FontSize="15"/>

                                <!--
                                    One line, title then subtitle in grey after
                                    an em dash — a stacked pair made every row
                                    two lines tall for a URL nobody reads.
                                -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock
                                        FontSize="13.5"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="13.5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SubtitleWithDash}"
                                        Visibility="{Binding SubtitleVisibility}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 'Switch to Tab' indicator — only where there is a tab to switch to -->
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SwitchToTabVisibility}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Switch to Tab"
                                        VerticalAlignment="Center" />
                                    <!-- The arrow alone: the chip behind it made a button of a label. -->
                                    <FontIcon
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE72A;" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
