<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriLauncher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Name="RevealAnimation">
            <DoubleAnimation Storyboard.TargetName="ScrimGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1" />
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1" />
        </Storyboard>
        <Storyboard x:Name="HideAnimation" Completed="HideAnimation_Completed">
            <DoubleAnimation Storyboard.TargetName="ScrimGrid" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
        </Storyboard>
    </UserControl.Resources>

    <!--
        Centered card, no scrim. The dimming wash is gone at the user's
        request; the layer stays, transparent, because it is still what
        catches a click outside the card and dismisses it — and a
        transparent background hit-tests where a null one does not.

        Sizes below are DIPs. The design is in pixels at 125%, so each
        figure is that pixel value over 1.25: 900px card, 65px field,
        60px rows, 30px favicons.
    -->
    <Grid x:Name="ScrimGrid" Background="Transparent" CornerRadius="10"
          PointerPressed="Scrim_PointerPressed" SizeChanged="ScrimGrid_SizeChanged">
        <!--
            Top-aligned, not centred: the list grows as results and completions
            arrive, and a centred card moves half of every new row upward — the
            palette jumped under the pointer while it was being read. PositionCard
            puts the top where a five-row card's top would be, so the card is
            centred when it is full and only ever grows downward into space that
            was already accounted for.
        -->
        <Border
            x:Name="Card"
            RenderTransformOrigin="0.5,0.5"
            Width="720"
            Margin="24,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#CC000000"
            BorderBrush="#676D6E"
            BorderThickness="1"
            CornerRadius="12"
            PointerPressed="Card_PointerPressed"
            Shadow="{ThemeResource SharedShadow}"
            Translation="0,0,32">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <StackPanel>
                <!-- Header: icon + search field + zoom label. 65px at 125%. -->
                <Grid Padding="16,0" Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The glass alone. The app mark that used to sit beside it
                        said only what window you were in, which the window
                        already says.
                    -->
                    <PathIcon Grid.Column="1" Margin="0,0,12,0" Width="15" Height="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Data="F1 M 6.45833 1.25 A 5.20833 5.20833 0 0 1 11.6667 6.45833 a 5.18333 5.18333 0 0 1 -1.11167 3.2125 l 3.01167 3.0125 a 0.625 0.625 0 0 1 -0.883333 0.883333 l -3.0125 -3.01167 A 5.18333 5.18333 0 0 1 6.45833 11.6667 a 5.20833 5.20833 0 0 1 0 -10.4167 m 0 1.25 a 3.95833 3.95833 0 1 0 0 7.91667 3.95833 3.95833 0 0 0 0 -7.91667" />

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        PlaceholderText="Search or Enter URL..."
                        KeyDown="SearchBox_KeyDown"
                        PreviewKeyDown="SearchBox_PreviewKeyDown"
                        TextChanged="SearchBox_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>
                </Grid>

                <!-- Separator -->
                <Border
                    Height="1"
                    Margin="14,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.45" />

                <!-- Results list -->
                <!--
                    No height of its own and no scrolling: the list is capped at
                    five rows in code, so it can size to its content and the
                    card grows and shrinks with it. A MaxHeight instead left a
                    scrollbar to appear the moment the rows and the padding
                    added up to more than the cap.
                -->
                <ListView
                    x:Name="ResultsList"
                    Padding="4,4,4,0"
                    SelectionMode="Single"
                    ItemClick="Result_Click"
                    IsItemClickEnabled="True"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <!--
                                4 below each row and 4,4,4,0 on the list: 4 to
                                the card on every side and 4 between any two
                                rows, from the last row's own margin at the
                                bottom. 5px at 125%.
                            -->
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="CornerRadius" Value="3.2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <!--
                                        A plain Grid, not ListViewItemPresenter.
                                        The presenter insets its own wash by an
                                        amount that is not ours to set, so the
                                        gaps on screen kept disagreeing with the
                                        gaps in the markup — 8 one side, 7 the
                                        other, from a symmetric figure. Here the
                                        wash fills the container exactly, so the
                                        only spacing is the margin above.
                                    -->
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid x:Name="RowRoot"
                                              Background="{TemplateBinding Background}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              MinHeight="{TemplateBinding MinHeight}">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <!--
                                                        One colour for hover,
                                                        press and selection: the
                                                        list is keyboard-driven,
                                                        and two different washes
                                                        read as two rows both
                                                        claiming to be next.
                                                    -->
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#181817" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#181817" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#181817" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOverSelected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#181817" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PressedSelected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#181817" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>

                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Padding="{TemplateBinding Padding}" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- 60px row, 30px favicon, both at 125%. -->
                            <Grid Height="48" Padding="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Show PersonPicture for existing tabs -->
                                <muxc:PersonPicture
                                    Grid.Column="0"
                                    Width="24" Height="24"
                                    Margin="0,0,12,0"
                                    Visibility="{Binding TabIconVisibility}"
                                    DisplayName="{Binding Title}"
                                    ProfilePicture="{Binding TabFaviconSource}" />

                                <!-- Show Search Icon for Google Fallback -->
                                <FontIcon
                                    Grid.Column="0"
                                    Width="24" Height="24"
                                    Margin="0,0,12,0"
                                    Visibility="{Binding SearchIconVisibility}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE721;"
                                    FontSize="15"/>

                                <!--
                                    One line, title then subtitle in grey after
                                    an em dash — a stacked pair made every row
                                    two lines tall for a URL nobody reads.

                                    A Grid, not a StackPanel: a horizontal stack
                                    hands its children all the width they ask
                                    for, so TextTrimming never fired and a long
                                    title ran straight under Switch to Tab. Here
                                    the title takes what is left and ellipsises.
                                -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 16 DIP throughout: 20px at 125%. -->
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="16"
                                        Text="{Binding Title}"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SubtitleWithDash}"
                                        Visibility="{Binding SubtitleVisibility}"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!--
                                    'Switch to Tab' indicator — only where there
                                    is a tab to switch to. 8 DIP of clear air to
                                    its left (10px at 125%), so a title long
                                    enough to be trimmed still stops short of it.
                                -->
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SwitchToTabVisibility}">
                                    <TextBlock
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Switch to Tab"
                                        VerticalAlignment="Center" />
                                    <!-- The arrow alone: the chip behind it made a button of a label. -->
                                    <FontIcon
                                        FontSize="14"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE72A;" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
