<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriLauncher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <!-- Full-window scrim + centered card (Spotlight-style command palette) -->
    <Grid Background="#40000000" PointerPressed="Scrim_PointerPressed">
        <Border
            MaxWidth="620"
            Margin="24,80,24,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            PointerPressed="Card_PointerPressed"
            Shadow="{ThemeResource SharedShadow}">
            <StackPanel>
                <!-- Header: icon + search field + zoom label -->
                <Grid Padding="16,0" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <PathIcon Grid.Column="0" Margin="0,0,10,0" Width="17" Height="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M 13.8125 1.59375 C 13.8125 2.47395 14.526 3.1875 15.4062 3.1875 H 15.9375 V 4.25 H 15.4062 C 14.8083 4.25 14.2565 4.05241 13.8125 3.71895 C 13.8126 4.59906 14.5261 5.3125 15.4062 5.3125 H 15.9375 V 6.375 H 15.4062 C 14.8083 6.375 14.2565 6.17743 13.8125 5.84396 V 7.96875 H 12.75 V 3.71895 C 12.306 4.05241 11.7542 4.25 11.1562 4.25 H 10.625 V 3.1875 H 11.1562 C 12.0365 3.1875 12.75 2.47395 12.75 1.59375 V 1.0625 H 13.8125 V 1.59375 Z M 5.84375 10.405 L 7.96875 12.53 V 15.4062 H 3.71875 V 12.53 L 5.84375 10.405 Z M 11.3763 5.3125 H 5.62371 L 1.0625 9.87371 V 15.9375 H 15.9375 V 9.87371 L 11.3763 5.3125 Z M 5.84375 6.59504 L 2.125 10.3138 V 14.875 H 9.5625 V 10.3138 L 5.84375 6.59504 Z M 3.71875 1.0625 C 2.25175 1.0625 1.0625 2.25175 1.0625 3.71875 C 1.0625 4.98171 1.94392 6.03877 3.12517 6.30843 L 4.8724 4.5612 C 5.07166 4.36194 5.34193 4.25 5.62371 4.25 H 6.32188 C 6.35672 4.07835 6.375 3.90069 6.375 3.71875 C 6.375 2.25175 5.18575 1.0625 3.71875 1.0625 Z" />

                    <PathIcon Grid.Column="1" Margin="0,0,8,0" Width="15" Height="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Data="F1 M 6.45833 1.25 A 5.20833 5.20833 0 0 1 11.6667 6.45833 a 5.18333 5.18333 0 0 1 -1.11167 3.2125 l 3.01167 3.0125 a 0.625 0.625 0 0 1 -0.883333 0.883333 l -3.0125 -3.01167 A 5.18333 5.18333 0 0 1 6.45833 11.6667 a 5.20833 5.20833 0 0 1 0 -10.4167 m 0 1.25 a 3.95833 3.95833 0 1 0 0 7.91667 3.95833 3.95833 0 0 0 0 -7.91667" />

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="15"
                        PlaceholderText="Search…"
                        KeyDown="SearchBox_KeyDown" />

                    <Border
                        Grid.Column="3"
                        Padding="7,3"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="100%" />
                    </Border>
                </Grid>

                <!-- Separator -->
                <Border
                    Height="1"
                    Margin="14,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.45" />

                <!-- Results list -->
                <ListView
                    x:Name="ResultsList"
                    MaxHeight="280"
                    Padding="6"
                    SelectionMode="Single"
                    ItemClick="Result_Click"
                    IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46" Padding="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <muxc:PersonPicture
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    Margin="0,0,10,0"
                                    DisplayName="{Binding Title}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding DisplayUrl}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
