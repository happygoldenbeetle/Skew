<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Skew.Controls.SkewFindBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="8,6"
        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox
                x:Name="FindTextBox"
                Width="220"
                PlaceholderText="Find on page…"
                CornerRadius="6"
                TextChanged="FindTextBox_TextChanged"
                KeyDown="FindTextBox_KeyDown" />
            <TextBlock
                x:Name="MatchCountText"
                Margin="4,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind FormatMatchCount(Store.SelectedTab.FindMatchCount, Store.SelectedTab.FindMatchOrdinal), Mode=OneWay}" />
            <Button
                Width="28" Height="28"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="6"
                ToolTipService.ToolTip="Previous"
                Click="Prev_Click">
                <FontIcon FontSize="10" Glyph="&#xE70E;" />
            </Button>
            <Button
                Width="28" Height="28"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="6"
                ToolTipService.ToolTip="Next"
                Click="Next_Click">
                <FontIcon FontSize="10" Glyph="&#xE70D;" />
            </Button>
            <Button
                Width="28" Height="28"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="6"
                ToolTipService.ToolTip="Close"
                Click="Close_Click">
                <FontIcon FontSize="10" Glyph="&#xE711;" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
