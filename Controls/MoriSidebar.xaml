<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Mori.Controls"
    xmlns:models="using:Mori.Models"
    mc:Ignorable="d">
    <Grid Background="Transparent" RightTapped="RootGrid_RightTapped">
        <Grid.RowDefinitions>
            <!-- Header: toggle + nav buttons + omnibox -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable tab list -->
            <RowDefinition Height="*" />
            <!-- Media player strip (future) -->
            <RowDefinition Height="Auto" />
            <!-- Bottom bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <StackPanel Grid.Row="0" Padding="10,10,10,6" Spacing="8">
            <!-- Navigation row: sidebar toggle | spacer | back / forward / reload / downloads -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SidebarToggle"
                    Grid.Column="0"
                    Width="28" Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SidebarToggle_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Toggle sidebar">
                    <ImageIcon x:Name="SidebarToggleIcon" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                        <ImageIcon.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/sidebar-right.svg" />
                        </ImageIcon.Source>
                        <ImageIcon.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </ImageIcon.RenderTransform>
                    </ImageIcon>
                </Button>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="BackButton"
                        Width="28" Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Back_Click"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Go back">
                        <PathIcon Data="F1 M 6.14667 2.81333 a 0.5 0.5 0 0 1 0.706667 0 l 2.83333 2.83333 a 0.5 0.5 0 0 1 0 0.706667 l -2.83333 2.83333 a 0.5 0.5 0 1 1 -0.706667 -0.706667 L 8.62667 6 6.14667 3.52 a 0.5 0.5 0 0 1 0 -0.706667 M 2.98 2.81333 a 0.5 0.5 0 0 1 0.706667 0 l 2.83333 2.83333 a 0.5 0.5 0 0 1 0 0.706667 l -2.83333 2.83333 a 0.5 0.5 0 1 1 -0.706667 -0.706667 L 5.46 6 2.98 3.52 a 0.5 0.5 0 0 1 0 -0.706667" Width="12" Height="12" RenderTransformOrigin="0.5,0.5"><PathIcon.RenderTransform><RotateTransform Angle="180" /></PathIcon.RenderTransform></PathIcon>
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        Width="28" Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Forward_Click"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Go forward">
                        <PathIcon Data="F1 M 6.14667 2.81333 a 0.5 0.5 0 0 1 0.706667 0 l 2.83333 2.83333 a 0.5 0.5 0 0 1 0 0.706667 l -2.83333 2.83333 a 0.5 0.5 0 1 1 -0.706667 -0.706667 L 8.62667 6 6.14667 3.52 a 0.5 0.5 0 0 1 0 -0.706667 M 2.98 2.81333 a 0.5 0.5 0 0 1 0.706667 0 l 2.83333 2.83333 a 0.5 0.5 0 0 1 0 0.706667 l -2.83333 2.83333 a 0.5 0.5 0 1 1 -0.706667 -0.706667 L 5.46 6 2.98 3.52 a 0.5 0.5 0 0 1 0 -0.706667" Width="12" Height="12" />
                    </Button>
                    <Button
                        x:Name="ReloadButton"
                        Width="28" Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Reload_Click"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Reload">
                        <PathIcon Data="F1 M 6 0.666667 a 5.32 5.32 0 0 1 4.17533 2.01667 l 0.0766667 -0.548667 a 0.5 0.5 0 0 1 0.99 0.136667 l -0.272 1.964 a 0.5 0.5 0 0 1 -0.564 0.426667 l -1.962 -0.271333 a 0.5 0.5 0 0 1 0.136667 -0.990667 l 0.983333 0.135333 a 4.33333 4.33333 0 1 0 0.767333 2.586 0.5 0.5 0 0 1 1 0.028 A 5.33333 5.33333 0 1 1 6 0.666667" Width="12" Height="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Omnibox (address/search bar) -->
            <AutoSuggestBox
                x:Name="OmniboxField"
                PlaceholderText="Search or enter address"
                QueryIcon="Find"
                QuerySubmitted="Omnibox_QuerySubmitted"
                CornerRadius="6"
                Height="30"
                MinHeight="30"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- ═══ Scrollable Tab Content ═══ -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="8,8,8,10" Spacing="10">

                <GridView
                    x:Name="PinnedGrid"
                    Margin="2,0"
                    SelectionMode="None"
                    CanReorderItems="True"
                    AllowDrop="True"
                    SizeChanged="PinnedGrid_SizeChanged">
                    <GridView.Resources>
                        <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </GridView.Resources>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ReorderThemeTransition />
                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left">
                                <ItemsWrapGrid.ChildrenTransitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                                    </TransitionCollection>
                                </ItemsWrapGrid.ChildrenTransitions>
                            </ItemsWrapGrid>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTab">
                            <controls:MoriPinnedTile Tab="{x:Bind}" Margin="0,0,6,6" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Separator after pins -->
                <Border
                    Height="1"
                    Margin="4,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.4"
                    Visibility="{x:Bind HasPins, Mode=OneWay}" />

                <!-- Folders -->
                <muxc:ItemsRepeater x:Name="FolderList">
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                <!-- Folder header -->
                                <Button
                                    Height="32"
                                    Padding="9,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Tag="{Binding Id}"
                                    Click="FolderHeader_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="{Binding Symbol}" />
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Text="{Binding Name}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- "New Tab" row -->
                <Button
                    x:Name="NewTabButton"
                    Height="32"
                    Padding="9,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="NewTab_Click"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Grid Width="20" Height="20">
                            <FontIcon FontSize="14" Glyph="&#xE710;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="New Tab" />
                    </StackPanel>
                </Button>

                <!-- Loose (unfiled) tabs -->
                <ListView
                    x:Name="LooseTabList"
                    SelectionMode="None"
                    CanReorderItems="True"
                    AllowDrop="True">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ReorderThemeTransition />
                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel>
                                <ItemsStackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                                    </TransitionCollection>
                                </ItemsStackPanel.ChildrenTransitions>
                            </ItemsStackPanel>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTab">
                            <controls:MoriTabRow Tab="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Bottom Bar ═══ -->
        <Grid Grid.Row="3" Padding="10,0,10,10" Height="46">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- AI toggle -->
            <Button
                Grid.Column="0"
                Width="30" Height="30"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="AIToggle_Click"
                CornerRadius="8"
                ToolTipService.ToolTip="Toggle AI Panel">
                <PathIcon Data="F1 M 2.35278 4.37344 a 0.389667 0.389667 0 0 0 0.738889 0 l 0.327444 -0.982333 0.982333 -0.327444 a 0.388889 0.388889 0 0 0 0 -0.737333 L 3.41911 1.99889 l -0.327444 -0.982333 c -0.106556 -0.317333 -0.631556 -0.317333 -0.738111 0 L 2.02611 1.99889 l -0.982333 0.327444 a 0.388889 0.388889 0 0 0 0 0.737333 l 0.982333 0.327444 z m 10.5 2.47333 L 9.32556 5.45222 l -1.39456 -3.52722 c -0.176556 -0.444889 -0.908444 -0.444889 -1.085 0 L 5.45144 5.45222 1.92422 6.84678 a 0.583333 0.583333 0 0 0 0 1.08422 l 3.52722 1.39456 1.39456 3.52722 a 0.583333 0.583333 0 0 0 1.08422 0 l 1.39456 -3.52722 3.52722 -1.39456 a 0.584111 0.584111 0 0 0 0.000777778 -1.08422" Width="14" Height="14" />
            </Button>

            <!-- Right side: position toggle + theme toggle + settings -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="PositionToggle"
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="PositionToggle_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Switch Sidebar Side">
                    <FontIcon x:Name="PositionIcon" FontSize="14" Glyph="&#xE90C;" />
                </Button>
                <Button
                    x:Name="ThemeToggle"
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ThemeToggle_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Toggle light / dark">
                    <PathIcon x:Name="ThemeIcon" Width="14" Height="14" Data="F1 M 12.9928 7.95122 a 0.583333 0.583333 0 0 0 -0.651778 -0.0287778 A 4.27778 4.27778 0 0 1 10.1111 8.55556 a 4.28244 4.28244 0 0 1 -4.27778 -4.27778 c 0 -0.891333 0.275333 -1.74767 0.795667 -2.478 a 0.583333 0.583333 0 0 0 -0.582556 -0.912333 A 6.22222 6.22222 0 0 0 0.972222 7 c 0 3.43078 2.79144 6.22222 6.22222 6.22222 a 6.21833 6.21833 0 0 0 6.01611 -4.65578 0.583333 0.583333 0 0 0 -0.217778 -0.614444" />
                </Button>
                <Button
                    x:Name="GlassPickerToggle"
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Click="GlassPickerToggle_Click"
                    ToolTipService.ToolTip="Customize Glass Tint">
                    <FontIcon FontSize="14" Glyph="&#xE790;" />
                </Button>
                <Button
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Settings_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Settings">
                    <PathIcon Data="F1 M 7 4.66667 a 2.33333 2.33333 0 1 1 0 4.66667 2.33333 2.33333 0 0 1 0 -4.66667 m 0 1.16667 a 1.16667 1.16667 0 1 0 0 2.33333 1.16667 1.16667 0 0 0 0 -2.33333 M 4.025 1.53144 a 1.83556 1.83556 0 0 1 2.11244 0.194444 l 0.385 0.330556 a 4.97778 4.97778 0 0 1 0.954333 -0.000777778 l 0.385 -0.328222 a 1.83556 1.83556 0 0 1 1.98411 -0.262889 l 0.128333 0.0676667 0.273778 0.157889 h -0.000777778 a 1.83556 1.83556 0 0 1 0.886667 1.92578 l -0.0933333 0.500889 c 0.091 0.124444 0.181222 0.256667 0.262889 0.398222 0.0816667 0.140778 0.150889 0.284667 0.213889 0.425444 l 0.479889 0.169556 0.0132222 0.00622222 a 1.83556 1.83556 0 0 1 1.21022 1.72589 V 7.15556 a 1.83556 1.83556 0 0 1 -1.22578 1.73211 l -0.477556 0.168 q -0.198333 0.434778 -0.477556 0.825222 l 0.0933333 0.500111 a 1.83556 1.83556 0 0 1 -0.886667 1.92656 l -0.272222 0.157111 a 1.83556 1.83556 0 0 1 -1.99889 -0.104222 l -0.114333 -0.0902222 -0.386556 -0.330556 q -0.478333 0.0458889 -0.952778 0 l -0.384222 0.329778 a 1.83556 1.83556 0 0 1 -2.11244 0.195222 l -0.272222 -0.158667 a 1.83556 1.83556 0 0 1 -0.887444 -1.92578 l 0.0933333 -0.501667 a 4.66667 4.66667 0 0 1 -0.261333 -0.396667 4.66667 4.66667 0 0 1 -0.216222 -0.426222 l -0.478333 -0.168778 A 1.83556 1.83556 0 0 1 0.777778 7.15556 v -0.314222 c 0 -0.777778 0.490778 -1.47311 1.225 -1.73211 l 0.476778 -0.168 a 4.97778 4.97778 0 0 1 0.478333 -0.826778 l -0.0933333 -0.497778 a 1.83556 1.83556 0 0 1 0.886667 -1.92656 z m 5.36511 1.01033 a 0.668889 0.668889 0 0 0 -0.769222 0.0715556 l -0.579444 0.495444 a 0.583333 0.583333 0 0 1 -0.468222 0.133778 3.81111 3.81111 0 0 0 -1.14878 0 0.583333 0.583333 0 0 1 -0.466667 -0.133778 l -0.579444 -0.496222 a 0.668889 0.668889 0 0 0 -0.77 -0.0707778 l -0.272222 0.157889 h -0.00155556 a 0.668889 0.668889 0 0 0 -0.322778 0.702333 l 0.14 0.750556 a 0.583333 0.583333 0 0 1 -0.117444 0.471333 c -0.243444 0.303333 -0.436333 0.637778 -0.575556 0.994 A 0.583333 0.583333 0 0 1 3.11111 5.95544 l -0.71