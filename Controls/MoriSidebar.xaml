<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Mori.Controls"
    xmlns:models="using:Mori.Models"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="False">
    
    <UserControl.Resources>
        <Storyboard x:Name="DownloadPulseAnim" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DownloadsButton"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.4" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="Transparent" RightTapped="RootGrid_RightTapped">
        <!--
            No header row. The nav buttons and the omnibox that used to open the
            sidebar are gone, Arc-style: the list starts at the pinned tiles and
            the address field moves to the title bar in a later pass. Ctrl+L has
            nothing to focus until it does.
        -->
        <Grid.RowDefinitions>
            <!-- Scrollable tab list -->
            <RowDefinition Height="*" />
            <!-- Media player strip (future) -->
            <RowDefinition Height="Auto" />
            <!-- Bottom bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Scrollable Tab Content ═══ -->
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <!--
                10 on the sides and bottom, so every section in the sidebar shares
                one left and right edge: pinned row, folder headers, tab rows,
                downloads. The sides ran at 8 against the old header's 10, which
                left the tab rows a step wider than the omnibox above them.

                Nothing on top: the pinned row starts on the same line as the web
                card next to it, both of them meeting the title bar. An inset
                here left the tiles floating below a card that had none.
            -->
            <StackPanel Padding="10,0,10,10" Spacing="10">

                <!--
                    A non-virtualizing ItemsControl, not an ItemsRepeater.

                    The peek copy of this sidebar is parked off-screen by a
                    render transform while closed. ItemsRepeater virtualizes
                    against the effective viewport, which accounts for
                    transforms, so off-screen means no realized items — and a
                    render transform triggers no layout, so sliding back in never
                    tells it to catch up. Layout size, unlike viewport, is
                    unaffected by transforms, so a panel that simply lays out
                    every child works in both copies. These lists are a handful
                    of items; virtualization bought nothing and cost this bug.

                    No negative right margin: the gutter is drawn inside each
                    tile now, so the row already ends flush. Widening the control
                    past its slot pushed the last cell beyond the viewport, which
                    made the row wrap and unwrap while dragging the sidebar edge.

                    PinnedTileGrid sizes its own cells during measure, so there
                    is no SizeChanged handler here — see its remarks for why one
                    was the source of the resize flicker.
                -->
                <!--
                    No side margin — the StackPanel's own padding is the inset
                    now. The 6 at the bottom is the gap the tiles used to draw
                    below themselves, kept so the space to the folders is
                    unchanged.
                -->
                <ItemsControl x:Name="PinnedGrid" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:PinnedTileGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTab">
                            <controls:MoriPinnedTile Tab="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Catch zone under an empty pinned grid, so the pinned area is
                    still a drop target before anything is pinned.
                -->
                <controls:SidebarDropZone
                    x:Name="PinnedDropZone"
                    Height="44"
                    ZoneCornerRadius="6"
                    Kind="Pinned"
                    Visibility="Collapsed" />

                <!--
                    No divider after the pins: the Mac sidebar separates sections
                    by spacing alone (Sidebar.swift), and a rule here reads as an
                    extra edge the Mac design does not have.
                -->

                <!-- Folders -->
                <ItemsControl x:Name="FolderList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TabFolder">
                            <StackPanel Spacing="2">
                                <!-- Folder header -->
                                <!--
                                    Ghost style, not the default Button: the Mac
                                    hover is a 5% foreground wash, where the
                                    stock WinUI Button fill is far heavier.
                                -->
                                <Button
                                    Height="32"
                                    Padding="9,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource MoriGhostButtonStyle}"
                                    CornerRadius="6"
                                    Tag="{x:Bind Id}"
                                    Click="FolderHeader_Click"
                                    AllowDrop="True"
                                    DragOver="FolderHeader_DragOver"
                                    DragLeave="FolderHeader_DragLeave"
                                    Drop="FolderHeader_Drop">
                                    
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Rename" Click="RenameFolder_Click" Tag="{x:Bind Id}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AC;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="New Tab in Folder" Click="NewTabInFolder_Click" Tag="{x:Bind Id}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE710;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete Folder" Click="DeleteFolder_Click" Tag="{x:Bind Id}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            No chevron: the Mac communicates
                                            open/closed entirely through the
                                            folder icon splaying open, and the
                                            dots that appear when a collapsed
                                            folder holds the active tab.
                                        -->
                                        <controls:MorphingFolderIcon
                                            Grid.Column="0"
                                            Width="24" Height="24"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            IsOpen="{x:Bind IsExpanded, Mode=OneWay}"
                                            ShowsDots="{x:Bind ShowsActiveDots, Mode=OneWay}" />

                                        <!-- Folder Name (Normal mode) -->
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind NormalVisibility, Mode=OneWay}" />

                                        <!-- Folder Rename (Editing mode) -->
                                        <TextBox
                                            Grid.Column="1"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind RenameVisibility, Mode=OneWay}"
                                            Padding="4,2"
                                            MinHeight="24"
                                            BorderThickness="0"
                                            LostFocus="RenameFolder_LostFocus"
                                            KeyDown="RenameFolder_KeyDown"
                                            Loaded="RenameFolder_Loaded"
                                            Tag="{x:Bind Id}">
                                            <TextBox.Resources>
                                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                <SolidColorBrush x:Key="TextControlBackground" Color="#35312e" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#35312e" />
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#35312e" />
                                            </TextBox.Resources>
                                        </TextBox>
                                    </Grid>
                                </Button>

                                <!--
                                    Tabs in the folder, plus the end cap that lets
                                    an empty folder receive tabs and lets a tab be
                                    appended after the last row.

                                    Both live inside one ExpandReveal so they open
                                    and close as a single block, sliding out from
                                    under the header rather than blinking in. The
                                    reveal takes one child, hence the StackPanel.
                                -->
                                <controls:ExpandReveal IsOpen="{x:Bind IsExpanded, Mode=OneWay}">
                                    <StackPanel Margin="16,0,0,0">
                                        <ItemsControl ItemsSource="{x:Bind Tabs, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:BrowserTab">
                                                    <controls:MoriTabRow Tab="{x:Bind}" Margin="0,0,0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <controls:SidebarDropZone
                                            Height="12"
                                            ZoneCornerRadius="2.4"
                                            Kind="Folder"
                                            FolderId="{x:Bind Id}" />
                                    </StackPanel>
                                </controls:ExpandReveal>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Rule between the folders and the loose side of the list, at
                    the user's request and matching Arc.

                    A deliberate divergence from Sidebar.swift, which separates
                    every section by spacing alone — the pinned row above still
                    has none, so this reads as the one break in the list rather
                    than as a general section style. The StackPanel's own 10 of
                    spacing sits on both sides of it, and the 10 side padding
                    puts its ends on the same line as every row's.
                -->
                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- "New Tab" row -->
                <Button
                    x:Name="NewTabButton"
                    Height="32"
                    Padding="9,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource MoriGhostButtonStyle}"
                    Click="NewTab_Click"
                    CornerRadius="6">
                    <!-- NewTabRow in Sidebar.swift: 15pt plus in a 16-wide slot, 9pt gap. -->
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Grid Width="16" Height="16">
                            <FontIcon FontSize="15" Glyph="&#xE710;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="New Tab" />
                    </StackPanel>
                </Button>

                <!-- Loose (unfiled) tabs -->
                <ItemsControl x:Name="LooseTabList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTab">
                            <controls:MoriTabRow Tab="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Catch zone below the loose rows: dropping into the empty area
                    under the list appends there. Always present, so the target
                    exists even with no loose tabs.
                -->
                <controls:SidebarDropZone
                    Height="24"
                    ZoneCornerRadius="2.4"
                    Kind="Loose" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Media Player Strip (shows while a tab is playing) ═══ -->
        <controls:MoriMediaPlayer
            Grid.Row="1"
            Visibility="{x:Bind MediaVisibility(Media.HasMedia), Mode=OneWay}" />

        <!--
            ═══ Bottom Bar ═══
            Downloads only. The AI, appearance and settings buttons were removed
            at the user's request and downloads was moved down here from the
            header nav row, so this intentionally diverges from
            SidebarBottomBar in Sidebar.swift.

            Both removed actions are still reachable: Settings from the sidebar
            context menu, light/dark from Settings.
        -->
        <Grid Grid.Row="2" Padding="10,0,10,0" Height="46">
            <Button
                x:Name="DownloadsButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="30" Height="30"
                Padding="0"
                Style="{StaticResource MoriGhostButtonStyle}"
                CornerRadius="10"
                ToolTipService.ToolTip="Downloads">
                <Button.Content>
                    <Grid>
                        <ProgressRing IsActive="{x:Bind Store.Downloads.HasActiveDownloads, Mode=OneWay}" Value="{x:Bind Store.Downloads.TotalPercent, Mode=OneWay}" IsIndeterminate="False" Width="18" Height="18" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Visibility="{x:Bind Store.Downloads.HasActiveDownloads, Mode=OneWay}"/>
                        <FontIcon x:Name="DownloadsIcon" Glyph="&#xE896;" FontSize="16" />
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <!-- Opens upward now that the button sits at the bottom edge. -->
                    <Flyout Placement="TopEdgeAlignedRight" ShouldConstrainToRootBounds="False" Opened="DownloadsFlyout_Opened">
                        <controls:DownloadsPanel />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
