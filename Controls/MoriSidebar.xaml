<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header: toggle + nav buttons + omnibox -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable tab list -->
            <RowDefinition Height="*" />
            <!-- Media player strip (future) -->
            <RowDefinition Height="Auto" />
            <!-- Bottom bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <StackPanel Grid.Row="0" Padding="10,12,10,6" Spacing="8">
            <!-- Navigation row: sidebar toggle | spacer | back / forward / reload / downloads -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SidebarToggle"
                    Grid.Column="0"
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SidebarToggle_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Toggle sidebar">
                    <FontIcon FontSize="14" Glyph="&#xE89F;" />
                </Button>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        x:Name="BackButton"
                        Width="30" Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Back_Click"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Go back">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        Width="30" Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Forward_Click"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Go forward">
                        <FontIcon FontSize="12" Glyph="&#xE72A;" />
                    </Button>
                    <Button
                        x:Name="ReloadButton"
                        Width="30" Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Reload_Click"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Reload">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Omnibox (address/search bar) -->
            <AutoSuggestBox
                x:Name="OmniboxField"
                PlaceholderText="Search or enter address"
                QueryIcon="Find"
                QuerySubmitted="Omnibox_QuerySubmitted"
                CornerRadius="10"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- ═══ Scrollable Tab Content ═══ -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="8,8,8,10" Spacing="8">

                <!-- Pinned tabs grid -->
                <muxc:ItemsRepeater
                    x:Name="PinnedGrid"
                    Layout="{StaticResource PinnedGridLayout}">
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="56" Height="40"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                BorderThickness="0"
                                CornerRadius="10"
                                Tag="{Binding Id}"
                                Click="PinnedTile_Click"
                                ToolTipService.ToolTip="{Binding Title}">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Unpin Tab" Tag="{Binding Id}" Click="PinTab_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77A;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Close Tab" Tag="{Binding Id}" Click="CloseTab_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <!-- Favicon or monogram -->
                                <Grid Width="20" Height="20">
                                    <muxc:PersonPicture
                                        Width="20" Height="20"
                                        DisplayName="{Binding Title}"
                                        Visibility="Visible" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- Separator after pins -->
                <Border
                    Height="1"
                    Margin="4,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.4"
                    Visibility="{x:Bind HasPins, Mode=OneWay}" />

                <!-- Folders -->
                <muxc:ItemsRepeater x:Name="FolderList">
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                <!-- Folder header -->
                                <Button
                                    Height="32"
                                    Padding="9,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Tag="{Binding Id}"
                                    Click="FolderHeader_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="{Binding Symbol}" />
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Text="{Binding Name}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- "New Tab" row -->
                <Button
                    x:Name="NewTabButton"
                    Height="32"
                    Padding="9,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="NewTab_Click"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE710;" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="New Tab" />
                    </StackPanel>
                </Button>

                <!-- Loose (unfiled) tabs -->
                <muxc:ItemsRepeater x:Name="LooseTabList">
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Height="34"
                                Padding="9,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Tag="{Binding Id}"
                                Click="TabRow_Click">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Pin Tab" Tag="{Binding Id}" Click="PinTab_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE718;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Close Tab" Tag="{Binding Id}" Click="CloseTab_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Favicon placeholder -->
                                    <muxc:PersonPicture
                                        Grid.Column="0"
                                        Width="16" Height="16"
                                        Margin="0,0,9,0"
                                        DisplayName="{Binding Title}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="13"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />

                                    <!-- Close button (visible on hover via code) -->
                                    <Button
                                        Grid.Column="2"
                                        Width="20" Height="20"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Tag="{Binding Id}"
                                        Click="CloseTab_Click"
                                        Opacity="0.5"
                                        ToolTipService.ToolTip="Close tab">
                                        <FontIcon FontSize="8" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Bottom Bar ═══ -->
        <Grid Grid.Row="3" Padding="10,0,10,10" Height="46">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- AI toggle -->
            <Button
                Grid.Column="0"
                Width="30" Height="30"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="AIToggle_Click"
                CornerRadius="8"
                ToolTipService.ToolTip="Toggle AI Panel">
                <FontIcon FontSize="14" Glyph="&#xE945;" />
            </Button>

            <!-- Right side: theme toggle + settings -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="ThemeToggle"
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ThemeToggle_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Toggle light / dark">
                    <FontIcon
                        x:Name="ThemeIcon"
                        FontSize="14"
                        Glyph="&#xE706;" />
                </Button>
                <Button
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Settings_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
