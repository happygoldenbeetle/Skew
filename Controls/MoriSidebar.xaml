<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header: toggle + nav buttons + omnibox -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable tab list -->
            <RowDefinition Height="*" />
            <!-- Media player strip (future) -->
            <RowDefinition Height="Auto" />
            <!-- Bottom bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <StackPanel Grid.Row="0" Padding="10,12,10,6" Spacing="8">
            <!-- Navigation row: sidebar toggle | spacer | back / forward / reload / downloads -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SidebarToggle"
                    Grid.Column="0"
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SidebarToggle_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Toggle sidebar">
                    <PathIcon Data="F1 M 12.2222 7.33333 a 0.666667 0.666667 0 0 1 0 1.33333 h -1.33333 a 0.666667 0.666667 0 0 1 0 -1.33333 z M 12.2222 4.88889 a 0.666667 0.666667 0 0 1 0 1.33333 h -1.33333 a 0.666667 0.666667 0 0 1 0 -1.33333 z M 12.6667 1.77778 A 2.44444 2.44444 0 0 1 15.1111 4.22222 v 7.55556 A 2.44444 2.44444 0 0 1 12.6667 14.2222 H 3.33333 A 2.44444 2.44444 0 0 1 0.888889 11.7778 v -7.55556 A 2.44444 2.44444 0 0 1 3.33333 1.77778 z M 3.33333 3.11111 c -0.613333 0 -1.11111 0.497778 -1.11111 1.11111 v 7.55556 c 0 0.613333 0.497778 1.11111 1.11111 1.11111 H 8 v -9.77778 z m 6 9.77778 h 3.33333 c 0.613333 0 1.11111 -0.497778 1.11111 -1.11111 v -7.55556 c 0 -0.613333 -0.497778 -1.11111 -1.11111 -1.11111 H 9.33333 z" Width="16" Height="16" RenderTransformOrigin="0.5,0.5"><PathIcon.RenderTransform><ScaleTransform ScaleX="-1" /></PathIcon.RenderTransform></PathIcon>
                </Button>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        x:Name="BackButton"
                        Width="30" Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Back_Click"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Go back">
                        <PathIcon Data="F1 M 6.14667 2.81333 a 0.5 0.5 0 0 1 0.706667 0 l 2.83333 2.83333 a 0.5 0.5 0 0 1 0 0.706667 l -2.83333 2.83333 a 0.5 0.5 0 1 1 -0.706667 -0.706667 L 8.62667 6 6.14667 3.52 a 0.5 0.5 0 0 1 0 -0.706667 M 2.98 2.81333 a 0.5 0.5 0 0 1 0.706667 0 l 2.83333 2.83333 a 0.5 0.5 0 0 1 0 0.706667 l -2.83333 2.83333 a 0.5 0.5 0 1 1 -0.706667 -0.706667 L 5.46 6 2.98 3.52 a 0.5 0.5 0 0 1 0 -0.706667" Width="12" Height="12" RenderTransformOrigin="0.5,0.5"><PathIcon.RenderTransform><RotateTransform Angle="180" /></PathIcon.RenderTransform></PathIcon>
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        Width="30" Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Forward_Click"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Go forward">
                        <PathIcon Data="F1 M 6.14667 2.81333 a 0.5 0.5 0 0 1 0.706667 0 l 2.83333 2.83333 a 0.5 0.5 0 0 1 0 0.706667 l -2.83333 2.83333 a 0.5 0.5 0 1 1 -0.706667 -0.706667 L 8.62667 6 6.14667 3.52 a 0.5 0.5 0 0 1 0 -0.706667 M 2.98 2.81333 a 0.5 0.5 0 0 1 0.706667 0 l 2.83333 2.83333 a 0.5 0.5 0 0 1 0 0.706667 l -2.83333 2.83333 a 0.5 0.5 0 1 1 -0.706667 -0.706667 L 5.46 6 2.98 3.52 a 0.5 0.5 0 0 1 0 -0.706667" Width="12" Height="12" />
                    </Button>
                    <Button
                        x:Name="ReloadButton"
                        Width="30" Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Reload_Click"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Reload">
                        <PathIcon Data="F1 M 6 0.666667 a 5.32 5.32 0 0 1 4.17533 2.01667 l 0.0766667 -0.548667 a 0.5 0.5 0 0 1 0.99 0.136667 l -0.272 1.964 a 0.5 0.5 0 0 1 -0.564 0.426667 l -1.962 -0.271333 a 0.5 0.5 0 0 1 0.136667 -0.990667 l 0.983333 0.135333 a 4.33333 4.33333 0 1 0 0.767333 2.586 0.5 0.5 0 0 1 1 0.028 A 5.33333 5.33333 0 1 1 6 0.666667" Width="12" Height="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Omnibox (address/search bar) -->
            <AutoSuggestBox
                x:Name="OmniboxField"
                PlaceholderText="Search or enter address"
                QueryIcon="Find"
                QuerySubmitted="Omnibox_QuerySubmitted"
                CornerRadius="10"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- ═══ Scrollable Tab Content ═══ -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="8,8,8,10" Spacing="8">

                <!-- Pinned tabs grid -->
                <muxc:ItemsRepeater
                    x:Name="PinnedGrid"
                    Layout="{StaticResource PinnedGridLayout}">
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="56" Height="40"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                BorderThickness="0"
                                CornerRadius="10"
                                Tag="{Binding Id}"
                                Click="PinnedTile_Click"
                                ToolTipService.ToolTip="{Binding Title}">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Unpin Tab" Tag="{Binding Id}" Click="PinTab_Click">
                                            <MenuFlyoutItem.Icon>
                                                <PathIcon Data="F1 M14.75 8.25a.75.75 0 0 1 0 1.5H3.25a.75.75 0 0 1 0-1.5z" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Close Tab" Tag="{Binding Id}" Click="CloseTab_Click">
                                            <MenuFlyoutItem.Icon>
                                                <PathIcon Data="F1 M13.47 3.47a.75.75 0 1 1 1.06 1.06L10.06 9l4.47 4.47a.75.75 0 1 1-1.06 1.06L9 10.06l-4.47 4.47a.75.75 0 0 1-1.06-1.06L7.94 9 3.47 4.53a.75.75 0 1 1 1.06-1.06L9 7.94z" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <!-- Favicon or monogram -->
                                <Grid Width="20" Height="20">
                                    <muxc:PersonPicture
                                        Width="20" Height="20"
                                        DisplayName="{Binding Title}"
                                        Visibility="Visible" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- Separator after pins -->
                <Border
                    Height="1"
                    Margin="4,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.4"
                    Visibility="{x:Bind HasPins, Mode=OneWay}" />

                <!-- Folders -->
                <muxc:ItemsRepeater x:Name="FolderList">
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                <!-- Folder header -->
                                <Button
                                    Height="32"
                                    Padding="9,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Tag="{Binding Id}"
                                    Click="FolderHeader_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="{Binding Symbol}" />
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Text="{Binding Name}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- "New Tab" row -->
                <Button
                    x:Name="NewTabButton"
                    Height="32"
                    Padding="9,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="NewTab_Click"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Width="13" Height="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Data="F1 M 6.5 1.80556 a 0.541667 0.541667 0 0 1 0.541667 0.541667 v 3.61111 h 3.61111 a 0.541667 0.541667 0 0 1 0 1.08333 h -3.61111 v 3.61111 a 0.541667 0.541667 0 0 1 -1.08333 0 v -3.61111 h -3.61111 a 0.541667 0.541667 0 0 1 0 -1.08333 h 3.61111 v -3.61111 A 0.541667 0.541667 0 0 1 6.5 1.80556" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="New Tab" />
                    </StackPanel>
                </Button>

                <!-- Loose (unfiled) tabs -->
                <muxc:ItemsRepeater x:Name="LooseTabList">
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Height="34"
                                Padding="9,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Tag="{Binding Id}"
                                Click="TabRow_Click">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Pin Tab" Tag="{Binding Id}" Click="PinTab_Click">
                                            <MenuFlyoutItem.Icon>
                                                <PathIcon Data="F1 M9.34 2.502a2.75 2.75 0 0 1 3.89 0l2.268 2.268a2.75 2.75 0 0 1 0 3.889l-2.803 2.8c-.03.46-.1.992-.25 1.567A8.3 8.3 0 0 1 11 15.962a.75.75 0 0 1-1.16.122L6.41 12.65l-2.799 2.8a.75.75 0 0 1-1.06-1.06l2.797-2.8-3.431-3.43a.75.75 0 0 1 .07-1.123 8.35 8.35 0 0 1 2.987-1.48l.262-.065a8 8 0 0 1 1.303-.188zm2.829 1.061a1.25 1.25 0 0 0-1.768 0L7.396 6.568a.75.75 0 0 1-.51.22c-.43.011-.953.066-1.53.217v.001a6.8 6.8 0 0 0-1.74.73l6.646 6.647a6.8 6.8 0 0 0 .732-1.739l.097-.423c.08-.41.113-.786.122-1.108l.016-.142a.75.75 0 0 1 .202-.368l3.005-3.005a1.25 1.25 0 0 0 0-1.767z" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Close Tab" Tag="{Binding Id}" Click="CloseTab_Click">
                                            <MenuFlyoutItem.Icon>
                                                <PathIcon Data="F1 M13.47 3.47a.75.75 0 1 1 1.06 1.06L10.06 9l4.47 4.47a.75.75 0 1 1-1.06 1.06L9 10.06l-4.47 4.47a.75.75 0 0 1-1.06-1.06L7.94 9 3.47 4.53a.75.75 0 1 1 1.06-1.06L9 7.94z" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Favicon placeholder -->
                                    <muxc:PersonPicture
                                        Grid.Column="0"
                                        Width="16" Height="16"
                                        Margin="0,0,9,0"
                                        DisplayName="{Binding Title}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="13"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />

                                    <!-- Close button (visible on hover via code) -->
                                    <Button
                                        Grid.Column="2"
                                        Width="20" Height="20"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Tag="{Binding Id}"
                                        Click="CloseTab_Click"
                                        Opacity="0.5"
                                        ToolTipService.ToolTip="Close tab">
                                        <PathIcon Data="F1 M 5.98667 1.54222 a 0.333333 0.333333 0 1 1 0.471111 0.471111 L 4.47111 4 l 1.98667 1.98667 a 0.333333 0.333333 0 1 1 -0.471111 0.471111 L 4 4.47111 l -1.98667 1.98667 a 0.333333 0.333333 0 0 1 -0.471111 -0.471111 L 3.52889 4 1.54222 2.01333 a 0.333333 0.333333 0 1 1 0.471111 -0.471111 L 4 3.52889 z" Width="8" Height="8" />
                                    </Button>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Bottom Bar ═══ -->
        <Grid Grid.Row="3" Padding="10,0,10,10" Height="46">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- AI toggle -->
            <Button
                Grid.Column="0"
                Width="30" Height="30"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="AIToggle_Click"
                CornerRadius="8"
                ToolTipService.ToolTip="Toggle AI Panel">
                <PathIcon Data="F1 M 2.35278 4.37344 a 0.389667 0.389667 0 0 0 0.738889 0 l 0.327444 -0.982333 0.982333 -0.327444 a 0.388889 0.388889 0 0 0 0 -0.737333 L 3.41911 1.99889 l -0.327444 -0.982333 c -0.106556 -0.317333 -0.631556 -0.317333 -0.738111 0 L 2.02611 1.99889 l -0.982333 0.327444 a 0.388889 0.388889 0 0 0 0 0.737333 l 0.982333 0.327444 z m 10.5 2.47333 L 9.32556 5.45222 l -1.39456 -3.52722 c -0.176556 -0.444889 -0.908444 -0.444889 -1.085 0 L 5.45144 5.45222 1.92422 6.84678 a 0.583333 0.583333 0 0 0 0 1.08422 l 3.52722 1.39456 1.39456 3.52722 a 0.583333 0.583333 0 0 0 1.08422 0 l 1.39456 -3.52722 3.52722 -1.39456 a 0.584111 0.584111 0 0 0 0.000777778 -1.08422" Width="14" Height="14" />
            </Button>

            <!-- Right side: theme toggle + settings -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="ThemeToggle"
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ThemeToggle_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Toggle light / dark">
                    <PathIcon x:Name="ThemeIcon" Width="14" Height="14" Data="F1 M 12.9928 7.95122 a 0.583333 0.583333 0 0 0 -0.651778 -0.0287778 A 4.27778 4.27778 0 0 1 10.1111 8.55556 a 4.28244 4.28244 0 0 1 -4.27778 -4.27778 c 0 -0.891333 0.275333 -1.74767 0.795667 -2.478 a 0.583333 0.583333 0 0 0 -0.582556 -0.912333 A 6.22222 6.22222 0 0 0 0.972222 7 c 0 3.43078 2.79144 6.22222 6.22222 6.22222 a 6.21833 6.21833 0 0 0 6.01611 -4.65578 0.583333 0.583333 0 0 0 -0.217778 -0.614444" />
                </Button>
                <Button
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Settings_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Settings">
                    <PathIcon Data="F1 M 7 4.66667 a 2.33333 2.33333 0 1 1 0 4.66667 2.33333 2.33333 0 0 1 0 -4.66667 m 0 1.16667 a 1.16667 1.16667 0 1 0 0 2.33333 1.16667 1.16667 0 0 0 0 -2.33333 M 4.025 1.53144 a 1.83556 1.83556 0 0 1 2.11244 0.194444 l 0.385 0.330556 a 4.97778 4.97778 0 0 1 0.954333 -0.000777778 l 0.385 -0.328222 a 1.83556 1.83556 0 0 1 1.98411 -0.262889 l 0.128333 0.0676667 0.273778 0.157889 h -0.000777778 a 1.83556 1.83556 0 0 1 0.886667 1.92578 l -0.0933333 0.500889 c 0.091 0.124444 0.181222 0.256667 0.262889 0.398222 0.0816667 0.140778 0.150889 0.284667 0.213889 0.425444 l 0.479889 0.169556 0.0132222 0.00622222 a 1.83556 1.83556 0 0 1 1.21022 1.72589 V 7.15556 a 1.83556 1.83556 0 0 1 -1.22578 1.73211 l -0.477556 0.168 q -0.198333 0.434778 -0.477556 0.825222 l 0.0933333 0.500111 a 1.83556 1.83556 0 0 1 -0.886667 1.92656 l -0.272222 0.157111 a 1.83556 1.83556 0 0 1 -1.99889 -0.104222 l -0.114333 -0.0902222 -0.386556 -0.330556 q -0.478333 0.0458889 -0.952778 0 l -0.384222 0.329778 a 1.83556 1.83556 0 0 1 -2.11244 0.195222 l -0.272222 -0.158667 a 1.83556 1.83556 0 0 1 -0.887444 -1.92578 l 0.0933333 -0.501667 a 4.66667 4.66667 0 0 1 -0.261333 -0.396667 4.66667 4.66667 0 0 1 -0.216222 -0.426222 l -0.478333 -0.168778 A 1.83556 1.83556 0 0 1 0.777778 7.15556 v -0.314222 c 0 -0.777778 0.490778 -1.47311 1.225 -1.73211 l 0.476778 -0.168 a 4.97778 4.97778 0 0 1 0.478333 -0.826778 l -0.0933333 -0.497778 a 1.83556 1.83556 0 0 1 0.886667 -1.92656 z m 5.36511 1.01033 a 0.668889 0.668889 0 0 0 -0.769222 0.0715556 l -0.579444 0.495444 a 0.583333 0.583333 0 0 1 -0.468222 0.133778 3.81111 3.81111 0 0 0 -1.14878 0 0.583333 0.583333 0 0 1 -0.466667 -0.133778 l -0.579444 -0.496222 a 0.668889 0.668889 0 0 0 -0.77 -0.0707778 l -0.272222 0.157889 h -0.00155556 a 0.668889 0.668889 0 0 0 -0.322778 0.702333 l 0.14 0.750556 a 0.583333 0.583333 0 0 1 -0.117444 0.471333 c -0.243444 0.303333 -0.436333 0.637778 -0.575556 0.994 A 0.583333 0.583333 0 0 1 3.11111 5.95544 l -0.719444 0.253556 a 0.668889 0.668889 0 0 0 -0.446444 0.632333 V 7.15556 c 0 0.283889 0.178889 0.536667 0.446444 0.631556 l 0.723333 0.255111 0.0583333 0.0241111 a 0.583333 0.583333 0 0 1 0.290111 0.313444 c 0.0723333 0.185889 0.150889 0.357778 0.244222 0.518778 0.0941111 0.162556 0.204556 0.317333 0.328222 0.473667 0.105778 0.132222 0.147778 0.303333 0.116667 0.469778 l -0.14 0.752889 a 0.668889 0.668889 0 0 0 0.237222 0.642444 l 0.0863333 0.0591111 0.273778 0.159444 a 0.668889 0.668889 0 0 0 0.769222 -0.0715556 l 0.579444 -0.496222 0.0505556 -0.0388889 a 0.583333 0.583333 0 0 1 0.417667 -0.0948889 c 0.374889 0.0583333 0.762222 0.0583333 1.14722 0 l 0.0622222 -0.00622222 a 0.583333 0.583333 0 0 1 0.404444 0.14 l 0.580222 0.497 0.0855556 0.0614444 a 0.668889 0.668889 0 0 0 0.684444 0.00933333 l 0.272222 -0.157889 0.0871111 -0.0598889 a 0.668889 0.668889 0 0 0 0.237222 -0.642444 l -0.14 -0.751333 a 0.583333 0.583333 0 0 1 0.118222 -0.471333 c 0.242667 -0.303333 0.435556 -0.637778 0.573222 -0.992444 l 0.0256667 -0.0575556 a 0.583333 0.583333 0 0 1 0.324333 -0.281556 l 0.719444 -0.253556 a 0.668889 0.668889 0 0 0 0.446444 -0.631556 v -0.314222 a 0.668889 0.668889 0 0 0 -0.446444 -0.632333 l -0.00622222 -0.00233333 -0.715556 -0.252778 a 0.583333 0.583333 0 0 1 -0.348444 -0.336778 3.88889 3.88889 0 0 0 -0.245 -0.521111 3.88889 3.88889 0 0 0 -0.326667 -0.470556 0.583333 0.583333 0 0 1 -0.119 -0.469778 l 0.14 -0.753667 a 0.668889 0.668889 0 0 0 -0.236444 -0.642444 l -0.0863333 -0.0598889 z" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
