<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Mori.Controls"
    xmlns:models="using:Mori.Models"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="False">
    
    <UserControl.Resources>
        <Storyboard x:Name="DownloadPulseAnim" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DownloadsButton"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.4" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="Transparent"
          RightTapped="RootGrid_RightTapped"
          PointerEntered="Sidebar_PointerEntered"
          PointerExited="Sidebar_PointerExited">
        <!--
            No header row. The nav buttons and the omnibox that used to open the
            sidebar are gone, Arc-style: the list starts at the pinned tiles and
            the address field moves to the title bar in a later pass. Ctrl+L has
            nothing to focus until it does.
        -->
        <Grid.RowDefinitions>
            <!-- Scrollable tab list -->
            <RowDefinition Height="*" />
            <!-- Media player strip (future) -->
            <RowDefinition Height="Auto" />
            <!-- Bottom bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Scrollable Tab Content ═══ -->
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <!--
                10 on the sides and bottom, so every section in the sidebar shares
                one left and right edge: pinned row, folder headers, tab rows,
                downloads. The sides ran at 8 against the old header's 10, which
                left the tab rows a step wider than the omnibox above them.

                Nothing on top for the docked copy: the pinned row starts on the
                same line as the web card next to it, both of them meeting the
                title bar. The peek copy is a floating card with a top edge of
                its own, so it asks for its inset back through TopInset.
            -->
            <StackPanel x:Name="ListStack" Padding="10,0,10,10" Spacing="10">

                <!--
                    A non-virtualizing ItemsControl, not an ItemsRepeater.

                    The peek copy of this sidebar is parked off-screen by a
                    render transform while closed. ItemsRepeater virtualizes
                    against the effective viewport, which accounts for
                    transforms, so off-screen means no realized items — and a
                    render transform triggers no layout, so sliding back in never
                    tells it to catch up. Layout size, unlike viewport, is
                    unaffected by transforms, so a panel that simply lays out
                    every child works in both copies. These lists are a handful
                    of items; virtualization bought nothing and cost this bug.

                    No negative right margin: the gutter is drawn inside each
                    tile now, so the row already ends flush. Widening the control
                    past its slot pushed the last cell beyond the viewport, which
                    made the row wrap and unwrap while dragging the sidebar edge.

                    PinnedTileGrid sizes its own cells during measure, so there
                    is no SizeChanged handler here — see its remarks for why one
                    was the source of the resize flicker.
                -->
                <!--
                    No side margin — the StackPanel's own padding is the inset
                    now. The 6 at the bottom is the gap the tiles used to draw
                    below themselves, kept so the space to the folders is
                    unchanged.
                -->
                <ItemsControl x:Name="PinnedGrid" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:PinnedTileGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTab">
                            <controls:MoriPinnedTile Tab="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Catch zone under an empty pinned grid, so the pinned area is
                    still a drop target before anything is pinned.
                -->
                <controls:SidebarDropZone
                    x:Name="PinnedDropZone"
                    Height="44"
                    ZoneCornerRadius="6"
                    Kind="Pinned"
                    Visibility="Collapsed" />

                <!--
                    No divider after the pins: the Mac sidebar separates sections
                    by spacing alone (Sidebar.swift), and a rule here reads as an
                    extra edge the Mac design does not have.
                -->

                <!-- Folders -->
                <ItemsControl x:Name="FolderList">
                    <!--
                        The gap between folders belongs here, on the panel that
                        stacks them, rather than as a margin on the template
                        root: a margin would sit inside each folder and be added
                        by an expanded empty one too, which is the nudge the
                        template's own Spacing was removed for.
                    -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TabFolder">
                            <!--
                                No Spacing: it applied to any visible child, and
                                an expanded empty folder is a visible child of
                                zero height — enough to nudge the whole list down
                                by 2 on open. The gap it provided lives on the
                                row list inside the reveal instead, where it
                                collapses along with the rows.
                            -->
                            <StackPanel>
                                <!-- Folder header -->
                                <!--
                                    Ghost style, not the default Button: the Mac
                                    hover is a 5% foreground wash, where the
                                    stock WinUI Button fill is far heavier.
                                -->
                                <!--
                                    5.6 both sides — the same inset the New Tab
                                    row and the tab rows carry, so the folder
                                    icon, the plus and the favicons all start on
                                    one line, and the row is even rather than
                                    heavier on the right as it was at 9.
                                -->
                                <Button
                                    Height="36"
                                    Padding="5.6,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource MoriFolderHeaderButtonStyle}"
                                    CornerRadius="6"
                                    Tag="{x:Bind Id}"
                                    Click="FolderHeader_Click"
                                    PointerEntered="FolderHeader_PointerEntered"
                                    PointerExited="FolderHeader_PointerExited"
                                    AllowDrop="True"
                                    DragOver="FolderHeader_DragOver"
                                    DragLeave="FolderHeader_DragLeave"
                                    Drop="FolderHeader_Drop">
                                    
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Rename" Click="RenameFolder_Click" Tag="{x:Bind Id}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AC;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="New Tab in Folder" Click="NewTabInFolder_Click" Tag="{x:Bind Id}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE710;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete Folder" Click="DeleteFolder_Click" Tag="{x:Bind Id}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            No chevron: the Mac communicates
                                            open/closed entirely through the
                                            folder icon splaying open, and the
                                            dots that appear when a collapsed
                                            folder holds the active tab.
                                        -->
                                        <!--
                                            The folder is drawn in a 32-unit
                                            space spanning 4.8 to 27.2, so its
                                            ink sits 15% of the box in from each
                                            side — 3.6 at this size. Both margins
                                            are net of that: -3.6 cancels the
                                            bearing so the drawn edge lands on the
                                            row's 5.6 padding like the favicons
                                            do, and 8.4 leaves the 15px gap to
                                            the label.
                                        -->
                                        <controls:MorphingFolderIcon
                                            Grid.Column="0"
                                            Width="24" Height="24"
                                            Margin="-3.6,0,8.4,0"
                                            VerticalAlignment="Center"
                                            IsOpen="{x:Bind IsExpanded, Mode=OneWay}"
                                            ShowsDots="{x:Bind ShowsActiveDots, Mode=OneWay}" />

                                        <!--
                                            Folder Name (Normal mode). Heavier
                                            than the tab rows it holds, and at
                                            full strength rather than their 0.78
                                            — a folder is the heading of what is
                                            under it, and matching the tabs made
                                            it disappear into them.
                                        -->
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13.6"
                                            FontWeight="SemiBold"
                                            Foreground="#D9DCDD"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind NormalVisibility, Mode=OneWay}" />

                                        <!--
                                            Folder Rename (Editing mode). Same
                                            size and weight as the label it
                                            stands in for, or the text jumps
                                            heavier the moment renaming starts.
                                        -->
                                        <TextBox
                                            Grid.Column="1"
                                            FontSize="13.6"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind RenameVisibility, Mode=OneWay}"
                                            Padding="4,2"
                                            MinHeight="24"
                                            BorderThickness="0"
                                            LostFocus="RenameFolder_LostFocus"
                                            KeyDown="RenameFolder_KeyDown"
                                            Loaded="RenameFolder_Loaded"
                                            Tag="{x:Bind Id}">
                                            <TextBox.Resources>
                                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                <SolidColorBrush x:Key="TextControlBackground" Color="#35312e" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#35312e" />
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#35312e" />
                                            </TextBox.Resources>
                                        </TextBox>

                                        <!--
                                            Close every open tab in the folder.
                                            Present only when there is something
                                            to close, and faded in on hover like
                                            a tab row's close button — a control
                                            that discards work should not sit
                                            under the pointer unannounced.
                                        -->
                                        <Button
                                            x:Name="FolderCloseAll"
                                            Grid.Column="2"
                                            Width="22" Height="22"
                                            Opacity="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MoriTabCloseButtonStyle}"
                                            Tag="{x:Bind Id}"
                                            Click="CloseFolderTabs_Click"
                                            Visibility="{x:Bind CloseAllVisibility, Mode=OneWay}"
                                            ToolTipService.ToolTip="Close this folder's tabs">
                                            <!--
                                                The same drawn bar the tab rows
                                                use, not a font glyph: a
                                                FontIcon's size is its em box and
                                                the minus fills a fraction of it,
                                                which is why this read small
                                                beside them.
                                            -->
                                            <Rectangle Width="13.6" Height="1.6"
                                                       RadiusX="0.8" RadiusY="0.8"
                                                       Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Button>

                                <!--
                                    A shut folder still shows what it has open,
                                    the way Arc does — the tabs stay reachable
                                    without expanding the whole group. Only while
                                    shut: expanded, the list below already holds
                                    them and both would show the same rows twice.
                                -->
                                <ItemsControl
                                    ItemsSource="{x:Bind OpenTabs, Mode=OneWay}"
                                    Margin="16,2,0,0"
                                    Visibility="{x:Bind CollapsedOpenTabsVisibility, Mode=OneWay}">
                                    <!--
                                        Spacing on the panel, not a margin on the
                                        rows: a row's own bottom margin follows
                                        the last one too, and stacked onto the
                                        gap between folders it left the next
                                        folder further away than the one before.
                                    -->
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:BrowserTab">
                                            <controls:MoriTabRow Tab="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--
                                    Tabs in the folder, plus the end cap that lets
                                    an empty folder receive tabs and lets a tab be
                                    appended after the last row.

                                    Both live inside one ExpandReveal so they open
                                    and close as a single block, sliding out from
                                    under the header rather than blinking in. The
                                    reveal takes one child, hence the StackPanel.
                                -->
                                <controls:ExpandReveal IsOpen="{x:Bind IsExpanded, Mode=OneWay}">
                                    <StackPanel Margin="16,0,0,0">
                                        <!--
                                            Both collapse when the folder is
                                            empty, so an expanded empty folder
                                            measures zero rather than a gap. The
                                            2 above the first row is the spacing
                                            the list used to add, moved in here
                                            where it goes away with the rows.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind Tabs, Mode=OneWay}"
                                                      Margin="0,2,0,0"
                                                      Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:BrowserTab">
                                                    <controls:MoriTabRow Tab="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            OnlyWhileDragging: the cap is a drop
                                            target and nothing else, so it takes
                                            no height until there is a drag to
                                            catch. Its 12 plus the 8 between
                                            folders was the gap under an expanded
                                            folder's last row.
                                        -->
                                        <controls:SidebarDropZone
                                            Height="12"
                                            ZoneCornerRadius="2.4"
                                            Kind="Folder"
                                            FolderId="{x:Bind Id}"
                                            OnlyWhileDragging="True" />
                                    </StackPanel>
                                </controls:ExpandReveal>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Rule between the folders and the loose side of the list, at
                    the user's request and matching Arc.

                    A deliberate divergence from Sidebar.swift, which separates
                    every section by spacing alone — the pinned row above still
                    has none, so this reads as the one break in the list rather
                    than as a general section style. The StackPanel's own 10 of
                    spacing sits on both sides of it, and the 10 side padding
                    puts its ends on the same line as every row's.
                -->
                <!--
                    Height fixed at the taller of its two states, and the extra
                    taken back out with a negative margin, so the row measures the
                    same whether Clear is there or not. Left to size itself it
                    grew from the rule's 1 to the button's 20 on hover and pushed
                    every row below it down.
                -->
                <Grid Height="20" Margin="0,-9.5,0,-9.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Height="1"
                               VerticalAlignment="Center"
                               Fill="#656D6E" />

                    <!--
                        Clear rides on the rule rather than sitting in a row of
                        its own, so it costs no height and the line gives way to
                        it. Collapsed rather than transparent while hidden: an
                        invisible button still holds its column open, which kept
                        the rule short of the edge even with nothing there.

                        Shown while the pointer is anywhere in the sidebar,
                        matching Arc — closing every loose tab at once is worth
                        reaching for, not worth hunting for.
                    -->
                    <Button x:Name="ClearTabsButton"
                            Grid.Column="1"
                            Height="20"
                            Padding="8,0"
                            Visibility="Collapsed"
                            Style="{StaticResource MoriBareButtonStyle}"
                            Click="ClearTabs_Click"
                            PointerEntered="ClearTabs_PointerEntered"
                            PointerExited="ClearTabs_PointerExited"
                            ToolTipService.ToolTip="Close all tabs below">
                        <!-- The label brightens on hover; there is no box behind it. -->
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <!--
                                A drawn arrow, not the ↓ character: at this size
                                the glyph's head is a couple of pixels and reads
                                as a plain stem. Stem and head are separate
                                strokes here, so the head is as wide as it needs
                                to be to be seen.
                            -->
                            <Path x:Name="ClearTabsArrow"
                                  Data="M 5,0.6 L 5,9.4 M 1.2,5.6 L 5,9.4 L 8.8,5.6"
                                  Stroke="#656D6E"
                                  StrokeThickness="1.3"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="10" Height="10"
                                  Stretch="None"
                                  VerticalAlignment="Center" />

                            <TextBlock x:Name="ClearTabsText"
                                       Text="Clear"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="#656D6E" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- "New Tab" row -->
                <Button
                    x:Name="NewTabButton"
                    Height="36"
                    Padding="5.6,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Style="{StaticResource MoriGhostButtonStyle}"
                    Click="NewTab_Click"
                    PointerEntered="NewTabButton_PointerEntered"
                    PointerExited="NewTabButton_PointerExited"
                    CornerRadius="6">
                    <!-- NewTabRow in Sidebar.swift: 15pt plus in a 16-wide slot, 9pt gap. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                            <FontIcon FontSize="15" Glyph="&#xE710;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock
                            Grid.Column="1"
                            Margin="9,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="New Tab" />

                        <!--
                            The shortcut, shown on hover rather than in a tooltip:
                            a tooltip teaches it only to whoever waits, and this
                            row is where the habit would be formed.
                        -->
                        <TextBlock
                            x:Name="NewTabShortcut"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Ctrl+T" />
                    </Grid>
                </Button>

                <!-- Loose (unfiled) tabs -->
                <ItemsControl x:Name="LooseTabList">
                    <!-- Row gap here rather than on the rows, as in the folders. -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTab">
                            <controls:MoriTabRow Tab="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Catch zone below the loose rows: dropping into the empty area
                    under the list appends there. Always present, so the target
                    exists even with no loose tabs.
                -->
                <controls:SidebarDropZone
                    Height="24"
                    ZoneCornerRadius="2.4"
                    Kind="Loose" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Media Player Strip (shows while a tab is playing) ═══ -->
        <controls:MoriMediaPlayer
            Grid.Row="1"
            Visibility="{x:Bind MediaVisibility(Media.HasMedia), Mode=OneWay}" />

        <!--
            ═══ Bottom Bar ═══
            Downloads only. The AI, appearance and settings buttons were removed
            at the user's request and downloads was moved down here from the
            header nav row, so this intentionally diverges from
            SidebarBottomBar in Sidebar.swift.

            Both removed actions are still reachable: Settings from the sidebar
            context menu, light/dark from Settings.
        -->
        <Grid Grid.Row="2" Padding="10,0,10,0" Height="46">
            <Button
                x:Name="DownloadsButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="30" Height="30"
                Padding="0"
                Style="{StaticResource MoriGhostButtonStyle}"
                CornerRadius="10"
                ToolTipService.ToolTip="Downloads">
                <Button.Content>
                    <Grid>
                        <ProgressRing IsActive="{x:Bind Store.Downloads.HasActiveDownloads, Mode=OneWay}" Value="{x:Bind Store.Downloads.TotalPercent, Mode=OneWay}" IsIndeterminate="False" Width="18" Height="18" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Visibility="{x:Bind Store.Downloads.HasActiveDownloads, Mode=OneWay}"/>
                        <FontIcon x:Name="DownloadsIcon" Glyph="&#xE896;" FontSize="16" />
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <!-- Opens upward now that the button sits at the bottom edge. -->
                    <Flyout Placement="TopEdgeAlignedRight" ShouldConstrainToRootBounds="False" Opened="DownloadsFlyout_Opened">
                        <controls:DownloadsPanel />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
