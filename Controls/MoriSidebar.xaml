<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Mori.Controls"
    xmlns:models="using:Mori.Models"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="False">
    
    <UserControl.Resources>
        <Storyboard x:Name="DownloadPulseAnim" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DownloadsButton"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.4" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="Transparent" RightTapped="RootGrid_RightTapped">
        <Grid.RowDefinitions>
            <!-- Header: toggle + nav buttons + omnibox -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable tab list -->
            <RowDefinition Height="*" />
            <!-- Media player strip (future) -->
            <RowDefinition Height="Auto" />
            <!-- Bottom bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <StackPanel Grid.Row="0" Padding="10,10,10,6" Spacing="8">
            <!--
                Navigation row: back / forward / reload, left-aligned.

                Diverges from SidebarHeader in Sidebar.swift at the user's
                request — the Mac puts a sidebar-toggle button on the left and
                pushes the nav buttons to the right. The toggle is gone here;
                hiding the sidebar is still on Ctrl+S and in the sidebar's
                context menu ("Hide Sidebar").
            -->
            <Grid>
                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="BackButton"
                        Width="28" Height="28"
                        Padding="0"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        Click="Back_Click"
                        CornerRadius="10"
                        ToolTipService.ToolTip="Go back">
                        <FontIcon Glyph="&#xE76B;" FontSize="16" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        Width="28" Height="28"
                        Padding="0"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        Click="Forward_Click"
                        CornerRadius="10"
                        ToolTipService.ToolTip="Go forward">
                        <FontIcon Glyph="&#xE76C;" FontSize="16" />
                    </Button>
                    <Button
                        x:Name="ReloadButton"
                        Width="28" Height="28"
                        Padding="0"
                        Style="{StaticResource MoriGhostButtonStyle}"
                        Click="Reload_Click"
                        CornerRadius="10"
                        ToolTipService.ToolTip="Reload">
                        <FontIcon x:Name="ReloadIcon" Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Omnibox (address/search bar) -->
            <controls:MoriOmnibox
                x:Name="OmniboxField"
                Store="{x:Bind Store, Mode=OneWay}"
                Tab="{x:Bind Store.SelectedTab, Mode=OneWay}"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- ═══ Scrollable Tab Content ═══ -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="8,8,8,10" Spacing="10">

                <GridView
                    x:Name="PinnedGrid"
                    Margin="2,0"
                    SelectionMode="None"
                    CanReorderItems="True"
                    AllowDrop="True"
                    SizeChanged="PinnedGrid_SizeChanged">
                    <GridView.Resources>
                        <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </GridView.Resources>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <ReorderThemeTransition />
                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left">
                                <ItemsWrapGrid.ChildrenTransitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                                    </TransitionCollection>
                                </ItemsWrapGrid.ChildrenTransitions>
                            </ItemsWrapGrid>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTab">
                            <controls:MoriPinnedTile Tab="{x:Bind}" Margin="0,0,6,6" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!--
                    Catch zone under an empty pinned grid, so the pinned area is
                    still a drop target before anything is pinned.
                -->
                <controls:SidebarDropZone
                    x:Name="PinnedDropZone"
                    Height="40"
                    Margin="2,0"
                    ZoneCornerRadius="10"
                    Kind="Pinned"
                    Visibility="Collapsed" />

                <!--
                    No divider after the pins: the Mac sidebar separates sections
                    by spacing alone (Sidebar.swift), and a rule here reads as an
                    extra edge the Mac design does not have.
                -->

                <!-- Folders -->
                <muxc:ItemsRepeater x:Name="FolderList">
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:TabFolder">
                            <StackPanel Spacing="2">
                                <!-- Folder header -->
                                <!--
                                    Ghost style, not the default Button: the Mac
                                    hover is a 5% foreground wash, where the
                                    stock WinUI Button fill is far heavier.
                                -->
                                <Button
                                    Height="32"
                                    Padding="9,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource MoriGhostButtonStyle}"
                                    CornerRadius="6"
                                    Tag="{x:Bind Id}"
                                    Click="FolderHeader_Click"
                                    AllowDrop="True"
                                    DragOver="FolderHeader_DragOver"
                                    DragLeave="FolderHeader_DragLeave"
                                    Drop="FolderHeader_Drop">
                                    
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Rename" Click="RenameFolder_Click" Tag="{x:Bind Id}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AC;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="New Tab in Folder" Click="NewTabInFolder_Click" Tag="{x:Bind Id}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE710;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete Folder" Click="DeleteFolder_Click" Tag="{x:Bind Id}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            No chevron: the Mac communicates
                                            open/closed entirely through the
                                            folder icon splaying open, and the
                                            dots that appear when a collapsed
                                            folder holds the active tab.
                                        -->
                                        <controls:MorphingFolderIcon
                                            Grid.Column="0"
                                            Width="24" Height="24"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            IsOpen="{x:Bind IsExpanded, Mode=OneWay}"
                                            ShowsDots="{x:Bind ShowsActiveDots, Mode=OneWay}" />

                                        <!-- Folder Name (Normal mode) -->
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind NormalVisibility, Mode=OneWay}" />

                                        <!-- Folder Rename (Editing mode) -->
                                        <TextBox
                                            Grid.Column="1"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind RenameVisibility, Mode=OneWay}"
                                            Padding="4,2"
                                            MinHeight="24"
                                            BorderThickness="0"
                                            LostFocus="RenameFolder_LostFocus"
                                            KeyDown="RenameFolder_KeyDown"
                                            Loaded="RenameFolder_Loaded"
                                            Tag="{x:Bind Id}">
                                            <TextBox.Resources>
                                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                <SolidColorBrush x:Key="TextControlBackground" Color="#35312e" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#35312e" />
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#35312e" />
                                            </TextBox.Resources>
                                        </TextBox>
                                    </Grid>
                                </Button>

                                <!-- Tabs in Folder -->
                                <muxc:ItemsRepeater
                                    ItemsSource="{x:Bind Tabs, Mode=OneWay}"
                                    Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}"
                                    Margin="16,0,0,0">
                                    <muxc:ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:BrowserTab">
                                            <controls:MoriTabRow Tab="{x:Bind}" Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </muxc:ItemsRepeater.ItemTemplate>
                                </muxc:ItemsRepeater>

                                <!--
                                    End cap: lets an empty folder receive tabs and
                                    lets a tab be appended after the last row.
                                -->
                                <controls:SidebarDropZone
                                    Height="12"
                                    Margin="16,0,0,0"
                                    ZoneCornerRadius="2.4"
                                    Kind="Folder"
                                    FolderId="{x:Bind Id}"
                                    Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- "New Tab" row -->
                <Button
                    x:Name="NewTabButton"
                    Height="32"
                    Padding="9,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource MoriGhostButtonStyle}"
                    Click="NewTab_Click"
                    CornerRadius="6">
                    <!-- NewTabRow in Sidebar.swift: 15pt plus in a 16-wide slot, 9pt gap. -->
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Grid Width="16" Height="16">
                            <FontIcon FontSize="15" Glyph="&#xE710;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="New Tab" />
                    </StackPanel>
                </Button>

                <!-- Loose (unfiled) tabs -->
                <ListView
                    x:Name="LooseTabList"
                    SelectionMode="None"
                    CanReorderItems="True"
                    AllowDrop="True">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <ReorderThemeTransition />
                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel>
                                <ItemsStackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                                    </TransitionCollection>
                                </ItemsStackPanel.ChildrenTransitions>
                            </ItemsStackPanel>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTab">
                            <controls:MoriTabRow Tab="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--
                    Catch zone below the loose rows: dropping into the empty area
                    under the list appends there. Always present, so the target
                    exists even with no loose tabs.
                -->
                <controls:SidebarDropZone
                    Height="24"
                    ZoneCornerRadius="2.4"
                    Kind="Loose" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Media Player Strip (shows while a tab is playing) ═══ -->
        <controls:MoriMediaPlayer
            Grid.Row="2"
            Visibility="{x:Bind MediaVisibility(Media.HasMedia), Mode=OneWay}" />

        <!--
            ═══ Bottom Bar ═══
            Downloads only. The AI, appearance and settings buttons were removed
            at the user's request and downloads was moved down here from the
            header nav row, so this intentionally diverges from
            SidebarBottomBar in Sidebar.swift.

            Both removed actions are still reachable: Settings from the sidebar
            context menu, light/dark from Settings.
        -->
        <Grid Grid.Row="3" Padding="10,0,10,0" Height="46">
            <Button
                x:Name="DownloadsButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="30" Height="30"
                Padding="0"
                Style="{StaticResource MoriGhostButtonStyle}"
                CornerRadius="10"
                ToolTipService.ToolTip="Downloads">
                <Button.Content>
                    <Grid>
                        <ProgressRing IsActive="{x:Bind Store.Downloads.HasActiveDownloads, Mode=OneWay}" Value="{x:Bind Store.Downloads.TotalPercent, Mode=OneWay}" IsIndeterminate="False" Width="18" Height="18" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Visibility="{x:Bind Store.Downloads.HasActiveDownloads, Mode=OneWay}"/>
                        <FontIcon x:Name="DownloadsIcon" Glyph="&#xE896;" FontSize="16" />
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <!-- Opens upward now that the button sits at the bottom edge. -->
                    <Flyout Placement="TopEdgeAlignedRight" ShouldConstrainToRootBounds="False" Opened="DownloadsFlyout_Opened">
                        <controls:DownloadsPanel />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
