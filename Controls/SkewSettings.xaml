<UserControl
    x:Class="Skew.Controls.SkewSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Skew.Models"
    mc:Ignorable="d">

    <!-- Reusable Styles for Sections -->
    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="CharacterSpacing" Value="40"/>
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{x:Bind Store.SettingsVisible, Mode=OneWay}">
        <Border Background="#66000000" Tapped="Scrim_Tapped" />

        <Border 
            Width="540" Height="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="10"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="56" Padding="18,0">
                    <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <Button x:Name="DoneButton" Content="Done" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Done_Click" Style="{ThemeResource AccentButtonStyle}"/>
                </Grid>

                <Border Grid.Row="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ScrollViewer Grid.Row="2" Padding="20">
                    <StackPanel Spacing="22">
                        
                        <!-- General -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="GENERAL" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="14">
                                    <!-- Homepage -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Homepage" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind Settings.HomepageURL, Mode=TwoWay}" PlaceholderText="https://..." />
                                    </Grid>
                                    
                                    <!-- New tab opens -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="New tab opens" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind NewTabBehaviorIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Open homepage" />
                                            <ComboBoxItem Content="Open a blank page" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Search -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="SEARCH" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Search engine" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind SearchEngineIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Google" />
                                            <ComboBoxItem Content="Bing" />
                                            <ComboBoxItem Content="DuckDuckGo" />
                                            <ComboBoxItem Content="Brave" />
                                            <ComboBoxItem Content="Custom..." />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Custom URL (visible only if Custom is selected) -->
                                    <Grid Visibility="{x:Bind CustomSearchVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Custom URL" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBox Text="{x:Bind Settings.CustomSearchTemplate, Mode=TwoWay}" PlaceholderText="https://example.com/?q={query}" />
                                            <TextBlock Text="Use {query} where the search terms should go." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Appearance -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="14">
                                    <!-- Theme -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ThemeIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="System" />
                                            <ComboBoxItem Content="Light" />
                                            <ComboBoxItem Content="Dark" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Sidebar side -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sidebar side" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind SidebarPositionIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Left" />
                                            <ComboBoxItem Content="Right" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Show sidebar on launch -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Show tab sidebar on launch" Style="{StaticResource FieldLabelStyle}" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.ShowSidebarOnLaunch, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- Reopen previous tabs -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Reopen tabs from last session" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Pinned tabs and folders always come back. With this off, Skew starts on a new tab instead of your last open page."
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind Settings.RestoreTabsOnLaunch, Mode=TwoWay}" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                                    <!-- Color theme -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Color theme" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="Pick an anime-inspired theme to wash the chrome and accent." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        
                                        <!-- Placeholder for ThemePicker -->
                                        <Border CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1" Height="60" Margin="0,8,0,0">
                                            <TextBlock Text="Theme Grid coming soon..." Foreground="{ThemeResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Media -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="MEDIA" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Automatic Picture in Picture" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Pop a playing video out when you switch tabs." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind Settings.AutoPiP, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Extensions -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="EXTENSIONS" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="14">
                                    <!-- Empty state (mac: "No extensions installed.") -->
                                    <TextBlock x:Name="NoExtensionsText" Text="No extensions installed."
                                               FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="Collapsed" />

                                    <ItemsControl ItemsSource="{x:Bind ExtensionsStore.Extensions, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:BrowserExtension">
                                                <Grid Padding="0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon (28x28) with a fallback glyph -->
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Margin="0,0,11,0"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE71D;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Image Source="{x:Bind IconImage}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Name + version + detail -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind VersionLabel}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Enable toggle -->
                                                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                                                  IsOn="{x:Bind Enabled, Mode=TwoWay}" Toggled="ExtensionToggle_Toggled" Tag="{x:Bind Id}" />

                                                    <!-- Remove (trash) -->
                                                    <Button Grid.Column="3" Width="30" Height="30" Padding="0"
                                                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                            Click="RemoveExtension_Click" Tag="{x:Bind Id}" ToolTipService.ToolTip="Remove extension">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Add Extension -->
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                        <Button Click="LoadUnpackedExtension_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                <TextBlock Text="Add Extension…" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="Load unpacked Chrome extensions (the folder containing manifest.json). Skew runs supported content scripts, extension pages, popups, and background/event scripts inside its own Chromium engine; the full chrome.* API surface is still in progress."
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- About -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="ABOUT" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource SectionCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Skew Logo placeholder using FontIcon for now -->
                                    <FontIcon Glyph="&#xE8A5;" FontSize="40" Foreground="{ThemeResource SystemAccentColor}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Skew" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="A native Windows browser powered by Chromium (CEF)." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="Version 0.1.0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
