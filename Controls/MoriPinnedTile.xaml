<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriPinnedTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        HorizontalAlignment="Stretch"
        MaxWidth="80"
        Height="40"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        CornerRadius="8"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        PointerPressed="RootGrid_PointerPressed"
        PointerReleased="RootGrid_PointerReleased"
        PointerCanceled="RootGrid_PointerReleased"
        Tapped="RootGrid_Tapped"
        RightTapped="RootGrid_RightTapped"
        RenderTransformOrigin="0.5,0.5"
        ToolTipService.ToolTip="{x:Bind Tab.Title, Mode=OneWay}">

        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootTransform" />
        </Grid.RenderTransform>

        <!-- Context Menu -->
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Unpin Tab" Click="UnpinTab_Click">
                    <MenuFlyoutItem.Icon>
                        <PathIcon Data="F1 M14.75 8.25a.75.75 0 0 1 0 1.5H3.25a.75.75 0 0 1 0-1.5z" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Close Tab" Click="CloseTab_Click">
                    <MenuFlyoutItem.Icon>
                        <PathIcon Data="F1 M13.47 3.47a.75.75 0 1 1 1.06 1.06L10.06 9l4.47 4.47a.75.75 0 1 1-1.06 1.06L9 10.06l-4.47 4.47a.75.75 0 0 1-1.06-1.06L7.94 9 3.47 4.53a.75.75 0 1 1 1.06-1.06L9 7.94z" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <!-- Motion.state = 150ms -->
                    <VisualTransition GeneratedDuration="0:0:0.15">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Width" Duration="0:0:0.15" EnableDependentAnimation="True" />
                            <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Height" Duration="0:0:0.15" EnableDependentAnimation="True" />
                        </Storyboard>
                    </VisualTransition>
                    <VisualTransition To="Selected" GeneratedDuration="0:0:0.15">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Width" To="16" Duration="0:0:0.15" EnableDependentAnimation="True" />
                            <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Height" To="2" Duration="0:0:0.15" EnableDependentAnimation="True" />
                        </Storyboard>
                    </VisualTransition>
                    <VisualTransition From="Selected" GeneratedDuration="0:0:0.15">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Width" To="4" Duration="0:0:0.15" EnableDependentAnimation="True" />
                            <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Height" To="4" Duration="0:0:0.15" EnableDependentAnimation="True" />
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Width" To="4" Duration="0" EnableDependentAnimation="True" />
                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Height" To="4" Duration="0" EnableDependentAnimation="True" />
                    </Storyboard>
                </VisualState>
                
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Width" To="4" Duration="0" EnableDependentAnimation="True" />
                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Height" To="4" Duration="0" EnableDependentAnimation="True" />
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Selected">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Width" To="16" Duration="0" EnableDependentAnimation="True" />
                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Height" To="2" Duration="0" EnableDependentAnimation="True" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="PressStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Released">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Base subtle resting fill (matches Mac's tileRestFill) -->
        <Grid Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="10" />

        <!-- Hover background (matches .white.opacity(0.10)) -->
        <Grid x:Name="HoverBackground" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" CornerRadius="10" />

        <!-- Selected background (Elevated card) -->
        <Border x:Name="SelectedBackground" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderThickness="0" 
                Translation="0,1,2"
                Opacity="0" 
                CornerRadius="10">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
        </Border>


        <!-- Icon Content (Centered) -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20">
            <ProgressRing
                IsActive="{x:Bind Tab.IsLoading, Mode=OneWay}"
                Width="16" Height="16"
                Visibility="{x:Bind GetVisibility(Tab.IsLoading), Mode=OneWay}" />

            <!-- Container for both fallback and favicon -->
            <Grid Visibility="{x:Bind GetInverseVisibility(Tab.IsLoading), Mode=OneWay}">
                
                <!-- Internal page icon (Magnifying Glass) -->
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE721;"
                    Margin="0,2,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind GetInternalIconVisibility(Tab), Mode=OneWay}" />

                <!-- Fallback Initial shown behind -->
                <Border
                    Width="20" Height="20"
                    CornerRadius="4"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    Visibility="{x:Bind GetFallbackVisibility(Tab), Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind GetInitial(Tab.Title), Mode=OneWay}"
                        FontSize="11" FontWeight="SemiBold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,-1,0,0" />
                </Border>

                <!-- Actual Favicon overlaid if available -->
                <Image
                    Width="20" Height="20"
                    Source="{x:Bind GetFaviconSource(Tab.FaviconUrl, Tab.UrlString), Mode=OneWay}"
                    Visibility="{x:Bind GetFaviconVisibility(Tab), Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- Running Indicator (Dot to Line) -->
        <Border
            x:Name="RunningIndicator"
            Height="4" Width="4"
            CornerRadius="2"
            Margin="0,0,0,3"
            Background="{ThemeResource TextFillColorSecondaryBrush}"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Visibility="{x:Bind GetVisibility(Tab.HasBrowserView), Mode=OneWay}" />

    </Grid>
</UserControl>
