<UserControl
    x:Class="Mori.Controls.MoriOmnibox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Mori.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlButtonForeground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0,0,0,0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0,0,0,0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,0</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            
            <PathIconSource x:Key="SearchGlassPath" Data="M7.75 1.5A6.25 6.25 0 0 1 14 7.75a6.22 6.22 0 0 1-1.334 3.855l3.614 3.615a.75.75 0 0 1-1.06 1.06l-3.615-3.614A6.22 6.22 0 0 1 7.75 14a6.25 6.25 0 0 1 0-12.5m0 1.5a4.75 4.75 0 1 0 0 9.5 4.75 4.75 0 0 0 0-9.5" />
            <PathIconSource x:Key="LockPath" Data="M9 1a4 4 0 0 1 4 4v2.513a2.75 2.75 0 0 1 2.5 2.737v4A2.75 2.75 0 0 1 12.75 17h-7.5a2.75 2.75 0 0 1-2.75-2.75v-4A2.75 2.75 0 0 1 5 7.513V5a4 4 0 0 1 4-4M5.25 9C4.56 9 4 9.56 4 10.25v4c0 .69.56 1.25 1.25 1.25h7.5c.69 0 1.25-.56 1.25-1.25v-4C14 9.56 13.44 9 12.75 9zM9 2.5A2.5 2.5 0 0 0 6.5 5v2.5h5V5A2.5 2.5 0 0 0 9 2.5" />
            <PathIconSource x:Key="WarningPath" Data="M8.75 12.75v-1a.75.75 0 0 1 1.5 0v1a.75.75 0 0 1-1.5 0M6.5 8.25V5a2.5 2.5 0 0 0-5 0v1.25a.75.75 0 0 1-1.5 0V5a4 4 0 0 1 8 0v3.25a.75.75 0 0 1-1.5 0 M14.5 10.25A1.25 1.25 0 0 0 13.25 9h-7.5a1.25 1.25 0 0 0-1.25 1.25v4a1.25 1.25 0 0 0 1.25 1.25h7.5a1.25 1.25 0 0 0 1.25-1.25zm1.5 4A2.75 2.75 0 0 1 13.25 17h-7.5A2.75 2.75 0 0 1 3 14.25v-4A2.75 2.75 0 0 1 5.75 7.5h7.5A2.75 2.75 0 0 1 16 10.25z" />
            <PathIconSource x:Key="ClosePath" Data="M13.47 3.47a.75.75 0 1 1 1.06 1.06L10.06 9l4.47 4.47a.75.75 0 1 1-1.06 1.06L9 10.06l-4.47 4.47a.75.75 0 0 1-1.06-1.06L7.94 9 3.47 4.53a.75.75 0 1 1 1.06-1.06L9 7.94z" />
            <PathIconSource x:Key="ExtensionFillPath" Data="M15.414 8.665a.75.75 0 0 0 1.086-.67V6.251a2.75 2.75 0 0 0-2.75-2.75h-1.775c.01-.083.025-.164.025-.25 0-1.103-.897-2-2-2s-2 .897-2 2c0 .086.015.167.025.25H6.25a2.75 2.75 0 0 0-2.75 2.75v1.775c-.083-.011-.164-.025-.25-.025-1.103 0-2 .897-2 2s.897 2 2 2c.086 0 .167-.015.25-.025v1.775a2.75 2.75 0 0 0 2.75 2.75h1.744c.26 0 .501-.135.638-.355a.75.75 0 0 0 .033-.73 1.5 1.5 0 0 1-.165-.665c0-.827.673-1.5 1.5-1.5s1.5.673 1.5 1.5q0 .333-.166.666a.75.75 0 0 0 .672 1.084h1.744a2.75 2.75 0 0 0 2.75-2.75v-1.744a.75.75 0 0 0-1.086-.67c-1.027.515-2.164-.285-2.164-1.335s1.134-1.85 2.164-1.335Z" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Height="30" CornerRadius="6">
        <!-- Idle Background -->
        <Border x:Name="IdleBackground" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}" Opacity="0.5" />
        
        <!-- Focused Background -->
        <Border x:Name="FocusedBackground" CornerRadius="6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0" />
        
        <!-- Border -->
        <Border x:Name="OuterBorder" CornerRadius="6" BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Icon -->
            <Border Grid.Column="0" Width="32" Background="Transparent" PointerPressed="LeftClickArea_PointerPressed">
                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <IconSourceElement x:Name="SecureIcon" IconSource="{StaticResource SearchGlassPath}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Viewbox>
            </Border>

            <!-- The AutoSuggestBox -->
            <AutoSuggestBox x:Name="InputBox"
                            Grid.Column="1"
                            PlaceholderText="Search or enter address"
                            FontSize="13"
                            UpdateTextOnSelect="False"
                            GotFocus="InputBox_GotFocus"
                            LostFocus="InputBox_LostFocus"
                            TextChanged="InputBox_TextChanged"
                            QuerySubmitted="InputBox_QuerySubmitted"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,0,0">
                <AutoSuggestBox.TextBoxStyle>
                    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="TextAlignment" Value="Center" />
                    </Style>
                </AutoSuggestBox.TextBoxStyle>
            </AutoSuggestBox>
            
            <!-- Right Side Items Stack -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Spacing="8">
                
                <!-- Pinned Extensions -->
                <ItemsControl x:Name="PinnedExtensionItems" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserExtension">
                            <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Padding="0" Click="PinnedExtensionButton_Click" Tag="{x:Bind Id}" ToolTipService.ToolTip="{x:Bind Name}">
                                <Image Source="{Binding IconUri}" Width="16" Height="16" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Extensions Menu Button -->
                <Button x:Name="ExtensionsMenuButton" Width="28" Height="28" Background="Transparent" BorderThickness="0" Padding="0" Visibility="Collapsed">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False">
                            <Grid Width="300">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Extensions" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <ListView x:Name="AllExtensionsList" Grid.Row="1" SelectionMode="None" ItemsSource="{x:Bind Extensions, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:BrowserExtension">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding IconUri}" Width="20" Height="20" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                <ToggleButton Grid.Column="2" IsChecked="{x:Bind Pinned, Mode=TwoWay}" Click="PinExtensionToggle_Click" Tag="{x:Bind Id}" Content="Pin" Width="50" FontSize="11" Padding="4,2" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                    <Viewbox Width="12" Height="12">
                        <PathIcon Data="M15 13.75v-1.265a2.5 2.5 0 1 1 0-4.972V6.25C15 5.56 14.44 5 13.75 5h-2.317a.75.75 0 0 1-.616-1.179A1 1 0 0 0 11 3.25a1 1 0 1 0-2 0c0 .211.066.405.182.57A.751.751 0 0 1 8.567 5H6.25C5.56 5 5 5.56 5 6.25v2.317a.75.75 0 0 1-1.179.616A.995.995 0 0 0 2.25 10a1 1 0 0 0 1 1c.21 0 .405-.066.57-.182a.751.751 0 0 1 1.18.615v2.317c0 .69.56 1.25 1.25 1.25h1.264a2.5 2.5 0 1 1 4.973 0h1.263c.69 0 1.25-.56 1.25-1.25m-2.5-10.5q0 .127-.014.25h1.264a2.75 2.75 0 0 1 2.75 2.75v2.317a.75.75 0 0 1-1.18.615A1 1 0 0 0 14.75 9a1 1 0 1 0 0 2 1 1 0 0 0 .571-.183.75.75 0 0 1 1.179.616v2.317a2.75 2.75 0 0 1-2.75 2.75h-2.317a.75.75 0 0 1-.615-1.18 1 1 0 0 0 .182-.57 1 1 0 1 0-2 0c0 .21.067.405.183.571a.75.75 0 0 1-.616 1.179H6.25a2.75 2.75 0 0 1-2.75-2.75v-1.265a2.5 2.5 0 1 1 0-4.972V6.25A2.75 2.75 0 0 1 6.25 3.5h1.264a2.5 2.5 0 1 1 4.986-.25" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Viewbox>
                </Button>

                <!-- Add to Mori Button -->
                <Button x:Name="AddExtensionButton" Padding="8,4,8,4" CornerRadius="12" Visibility="Collapsed" Click="AddExtensionButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="11" Height="11">
                            <PathIcon Data="M15.414 8.665a.75.75 0 0 0 1.086-.67V6.251a2.75 2.75 0 0 0-2.75-2.75h-1.775c.01-.083.025-.164.025-.25 0-1.103-.897-2-2-2s-2 .897-2 2c0 .086.015.167.025.25H6.25a2.75 2.75 0 0 0-2.75 2.75v1.775c-.083-.011-.164-.025-.25-.025-1.103 0-2 .897-2 2s.897 2 2 2c.086 0 .167-.015.25-.025v1.775a2.75 2.75 0 0 0 2.75 2.75h1.744c.26 0 .501-.135.638-.355a.75.75 0 0 0 .033-.73 1.5 1.5 0 0 1-.165-.665c0-.827.673-1.5 1.5-1.5s1.5.673 1.5 1.5q0 .333-.166.666a.75.75 0 0 0 .672 1.084h1.744a2.75 2.75 0 0 0 2.75-2.75v-1.744a.75.75 0 0 0-1.086-.67c-1.027.515-2.164-.285-2.164-1.335s1.134-1.85 2.164-1.335Z" />
                        </Viewbox>
                        <TextBlock Text="Add to Mori" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Custom Clear Button -->
                <Button x:Name="ClearButton" Width="28" Height="28" Background="Transparent" BorderThickness="0" Padding="0" Visibility="Collapsed" Click="ClearButton_Click">
                    <Viewbox Width="12" Height="12">
                        <IconSourceElement IconSource="{StaticResource ClosePath}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Viewbox>
                </Button>

                <!-- Loading Spinner -->
                <ProgressRing x:Name="LoadingSpinner" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Margin="0,0,4,0" IsHitTestVisible="False" />
                
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
