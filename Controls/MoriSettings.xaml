<UserControl
    x:Class="Mori.Controls.MoriSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid Visibility="{x:Bind Store.SettingsVisible, Mode=OneWay}">
        <Border Background="#66000000" Tapped="Scrim_Tapped" />

        <Border 
            Width="540" Height="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="56" Padding="18,0">
                    <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <Button Content="Done" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Done_Click" Style="{ThemeResource AccentButtonStyle}"/>
                </Grid>

                <Border Grid.Row="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ScrollViewer Grid.Row="2" Padding="20">
                    <StackPanel Spacing="22">
                        
                        <!-- General -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="GENERAL" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="40"/>
                            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Homepage" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{x:Bind Settings.HomepageURL, Mode=TwoWay}" PlaceholderText="https://..." />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Appearance -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="APPEARANCE" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="40"/>
                            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                                <StackPanel Spacing="14">
                                    <ToggleSwitch Header="Show sidebar on launch" IsOn="{x:Bind Settings.ShowSidebarOnLaunch, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
