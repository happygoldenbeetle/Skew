<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Skew.Controls.SkewBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <!--
      Chromium renders offscreen and we present its frames into this Image, so
      the page is ordinary XAML content: it clips to rounded corners, animates
      with the rest of the chrome, and anything can be drawn over it. The old
      windowed path parented a native child HWND here instead, which always
      composited above every XAML layer and made the Mac design impossible.

      Stretch="Fill" is correct rather than lazy: the bitmap is allocated at the
      exact device-pixel size of this control, so filling reproduces it 1:1 at
      any DPI.
    -->
    <Grid x:Name="HostPanel" Background="Transparent"
          PointerPressed="HostPanel_PointerPressed"
          PointerMoved="HostPanel_PointerMoved"
          PointerReleased="HostPanel_PointerReleased"
          PointerExited="HostPanel_PointerExited"
          PointerCanceled="HostPanel_PointerCanceled"
          PointerCaptureLost="HostPanel_PointerCaptureLost"
          PointerWheelChanged="HostPanel_PointerWheelChanged">
        <Image x:Name="Surface"
               Stretch="Fill"
               IsHitTestVisible="False" />
    </Grid>
</UserControl>
