<UserControl
    x:Class="Skew.Controls.DownloadsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Skew.Models"
    mc:Ignorable="d"
    Width="360"
    MaxHeight="420">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Height="44" Padding="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Downloads" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button Content="Folder" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Background="Transparent" BorderThickness="0" Click="Folder_Click" Padding="4" />
                <Button x:Name="ClearButton" Content="Clear" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Background="Transparent" BorderThickness="0" Click="Clear_Click" Padding="4" Visibility="{x:Bind Store.HasClearableDownloads, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Hairline -->
        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.6"/>

        <!-- Empty State -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="8" Padding="0,40" HorizontalAlignment="Center" Visibility="{x:Bind Store.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE896;" FontSize="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="No downloads yet" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- List -->
        <ScrollViewer Grid.Row="2" Padding="8" Visibility="{x:Bind Store.HasItems, Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind Store.Items, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Grid Padding="10,8" CornerRadius="4" Background="Transparent" DoubleTapped="Row_DoubleTapped" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited" PointerPressed="Row_PointerPressed" CanDrag="{x:Bind IsComplete, Mode=OneWay}" DragStarting="Row_DragStarting">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Icon -->
                            <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind HasNoFileIcon, Mode=OneWay}" />
                                <Image Source="{x:Bind FileIcon, Mode=OneWay}" Stretch="Uniform" Visibility="{x:Bind HasFileIcon, Mode=OneWay}" />
                            </Grid>

                            <!-- Details -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" Margin="11,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                
                                <!-- Progress Bar -->
                                <ProgressBar Value="{x:Bind FractionComplete, Mode=OneWay}" Minimum="0" Maximum="1" Height="2" Margin="0,1" Visibility="{x:Bind IsProgressVisible, Mode=OneWay}" />
                                
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Visibility="{x:Bind IsCancelVisible, Mode=OneWay}" Click="Cancel_Click" Background="Transparent" BorderThickness="0" Padding="4" ToolTipService.ToolTip="Cancel download">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                                <Button Visibility="{x:Bind IsRevealVisible, Mode=OneWay}" Click="Reveal_Click" Background="Transparent" BorderThickness="0" Padding="4" ToolTipService.ToolTip="Show in folder">
                                    <FontIcon Glyph="&#xE71E;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
