<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriTabRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        HorizontalAlignment="Stretch"
        Height="34"
        Margin="0,0,0,2"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        PointerPressed="RootGrid_PointerPressed"
        PointerReleased="RootGrid_PointerReleased"
        PointerCanceled="RootGrid_PointerReleased"
        Tapped="RootGrid_Tapped"
        RightTapped="RootGrid_RightTapped"
        CanDrag="True"
        AllowDrop="True"
        DragStarting="RootGrid_DragStarting"
        DropCompleted="RootGrid_DropCompleted"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootTransform" />
        </Grid.RenderTransform>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <!-- Motion.state = 150ms -->
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="CloseButton" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="TitleTextBlock" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="FaviconGrid" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0" />
                    </Storyboard>
                </VisualState>
                
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="CloseButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="TitleTextBlock" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="FaviconGrid" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Selected">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="CloseButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="TitleTextBlock" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="FaviconGrid" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="PressStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Released">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            Fills come from TabSurface, applied in code-behind, not from Fluent
            theme brushes: the Mac values are plain white/black alphas over the
            translucent sidebar, and the Fluent equivalents read noticeably
            heavier.
        -->
        <Grid x:Name="HoverBackground" Opacity="0" CornerRadius="6" />

        <Border x:Name="SelectedBackground"
                BorderThickness="0"
                Opacity="0"
                CornerRadius="6"
                Translation="0,1,2">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
        </Border>

        <!-- Content -->
        <Grid Margin="9,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Favicon is 15pt on the Mac (TabRow.swift), not 20 — a 20pt icon
                makes the row read as a list item rather than a tab.
            -->
            <Grid x:Name="FaviconGrid" Grid.Column="0" Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center" Opacity="0.9">
                <ProgressRing
                    IsActive="{x:Bind Tab.IsLoading, Mode=OneWay}"
                    Width="15" Height="15"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind GetVisibility(Tab.IsLoading), Mode=OneWay}" />

                <!-- Temporary fallback icon when not loading -->
                <FontIcon
                    FontSize="12"
                    Glyph="&#xE774;"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind GetFallbackVisibility(Tab), Mode=OneWay}" />

                <!-- Internal page icon (Magnifying Glass) -->
                <FontIcon
                    FontSize="12"
                    Glyph="&#xE721;"
                    Margin="0,1,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind GetInternalIconVisibility(Tab), Mode=OneWay}" />

                <!-- Actual Favicon overlaid if available -->
                <Image
                    Width="15" Height="15"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Source="{x:Bind GetFaviconSource(Tab.FaviconUrl, Tab.UrlString), Mode=OneWay}"
                    Visibility="{x:Bind GetFaviconVisibility(Tab), Mode=OneWay}" />
            </Grid>

            <!-- Title -->
            <TextBlock
                x:Name="TitleTextBlock"
                Grid.Column="1"
                Text="{x:Bind Tab.Title, Mode=OneWay}"
                VerticalAlignment="Center"
                Margin="0,-1,0,0"
                FontSize="13"
                Opacity="0.78"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- Close Button -->
            <Button
                x:Name="CloseButton"
                Grid.Column="2"
                Width="18" Height="18"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Opacity="0"
                CornerRadius="5"
                Click="Close_Click"
                ToolTipService.ToolTip="Close tab">
                <PathIcon Data="F1 M 7.48333 1.92778 a 0.416667 0.416667 0 1 1 0.588889 0.588889 L 5.58889 5 l 2.48333 2.48333 a 0.416667 0.416667 0 1 1 -0.588889 0.588889 L 5 5.58889 l -2.48333 2.48333 a 0.416667 0.416667 0 0 1 -0.588889 -0.588889 L 4.41111 5 1.92778 2.51667 a 0.416667 0.416667 0 1 1 0.588889 -0.588889 L 5 4.41111 z" Width="10" Height="10" />
            </Button>
        </Grid>



    </Grid>
</UserControl>
