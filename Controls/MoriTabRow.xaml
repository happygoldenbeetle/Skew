<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriTabRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        HorizontalAlignment="Stretch"
        Height="34"
        Margin="0,0,0,2"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        Tapped="RootGrid_Tapped"
        RightTapped="RootGrid_RightTapped">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <!-- Motion.state = 150ms -->
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="CloseButton" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                    </Storyboard>
                </VisualState>
                
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="CloseButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Selected">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="CloseButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Hover background (SubtleFillColorSecondaryBrush) -->
        <Grid x:Name="HoverBackground" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" CornerRadius="6" />

        <!-- Selected background (Elevated card) -->
        <Border x:Name="SelectedBackground" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                Opacity="0" 
                CornerRadius="6">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
        </Border>

        <!-- Content -->
        <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Favicon placeholder (Grid prevents auto-collapse when empty) -->
            <Grid Grid.Column="0" Width="15" Height="15" Margin="0,0,9,0">
                <ProgressRing
                    IsActive="{x:Bind Tab.IsLoading, Mode=OneWay}"
                    Width="14" Height="14"
                    Visibility="{x:Bind GetVisibility(Tab.IsLoading), Mode=OneWay}" />

                <!-- Temporary fallback icon when not loading -->
                <FontIcon
                    FontSize="12"
                    Glyph="&#xE774;"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind GetInverseVisibility(Tab.IsLoading), Mode=OneWay}" />
            </Grid>

            <!-- Title -->
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind Tab.Title, Mode=OneWay}"
                VerticalAlignment="Center"
                FontSize="13"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- Close Button -->
            <Button
                x:Name="CloseButton"
                Grid.Column="2"
                Width="18" Height="18"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Opacity="0"
                CornerRadius="5"
                Click="Close_Click"
                ToolTipService.ToolTip="Close tab">
                <PathIcon Data="F1 M 7.48333 1.92778 a 0.416667 0.416667 0 1 1 0.588889 0.588889 L 5.58889 5 l 2.48333 2.48333 a 0.416667 0.416667 0 1 1 -0.588889 0.588889 L 5 5.58889 l -2.48333 2.48333 a 0.416667 0.416667 0 0 1 -0.588889 -0.588889 L 4.41111 5 1.92778 2.51667 a 0.416667 0.416667 0 1 1 0.588889 -0.588889 L 5 4.41111 z" Width="10" Height="10" />
            </Button>
        </Grid>

        <!-- Context Menu -->
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Pin Tab" Click="Pin_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE718;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Close" Click="Close_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8BB;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

    </Grid>
</UserControl>
