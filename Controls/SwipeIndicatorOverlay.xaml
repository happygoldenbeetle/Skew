<UserControl
    x:Class="Skew.Controls.SwipeIndicatorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ThemeShadow x:Name="SharedShadow" />
        <SolidColorBrush x:Key="TranslucentPillBrush" Color="{ThemeResource SystemAltHighColor}" Opacity="0.8" />
    </UserControl.Resources>

    <Grid x:Name="Container" CornerRadius="10">
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,4000,4000" />
        </Grid.Clip>
        <Border
            x:Name="Indicator"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{StaticResource TranslucentPillBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Width="48" Height="48"
            Opacity="0"
            Margin="-24,0,0,0"
            Shadow="{StaticResource SharedShadow}"
            Translation="0,0,32"
            IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="IndicatorTransform" X="0" />
            </Border.RenderTransform>
            <FontIcon
                x:Name="IndicatorIcon"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Glyph="&#xE72B;">
                <FontIcon.RenderTransform>
                    <TranslateTransform x:Name="IconTransform" X="0" />
                </FontIcon.RenderTransform>
            </FontIcon>
        </Border>
    </Grid>
</UserControl>
