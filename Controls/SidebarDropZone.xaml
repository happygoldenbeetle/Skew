<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.SidebarDropZone"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">

    <!--
        Port of SidebarDropCatchZone (Sidebar.swift). Without these, the only drop
        targets are the rows themselves, so dropping a tab into the empty area
        below a list — or into an empty folder, or an empty pinned grid — does
        nothing. Transparent at rest; a quiet wash while targeted.
    -->
    <Border x:Name="Surface" Background="Transparent" HorizontalAlignment="Stretch" />
</UserControl>
