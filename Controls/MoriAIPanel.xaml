<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriAIPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="360">

    <Grid>
        <Grid.Resources>
            <Storyboard x:Name="AIPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation 
                    Storyboard.TargetName="AIIcon"
                    Storyboard.TargetProperty="Opacity"
                    From="1.0" To="0.4" Duration="0:0:0.75" />
            </Storyboard>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="14,12" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <PathIcon x:Name="AIIcon" Grid.Column="0" Margin="0,0,8,0" Width="15" Height="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M 2.52083 4.68583 a 0.4175 0.4175 0 0 0 0.791667 0 l 0.350833 -1.0525 1.0525 -0.350833 a 0.416667 0.416667 0 0 0 0 -0.79 L 3.66333 2.14167 l -0.350833 -1.0525 c -0.114167 -0.34 -0.676667 -0.34 -0.790833 0 L 2.17083 2.14167 l -1.0525 0.350833 a 0.416667 0.416667 0 0 0 0 0.79 l 1.0525 0.350833 z m 11.25 2.65 L 9.99167 5.84167 l -1.49417 -3.77917 c -0.189167 -0.476667 -0.973333 -0.476667 -1.1625 0 L 5.84083 5.84167 2.06167 7.33583 a 0.625 0.625 0 0 0 0 1.16167 l 3.77917 1.49417 1.49417 3.77917 a 0.625 0.625 0 0 0 1.16167 0 l 1.49417 -3.77917 3.77917 -1.49417 a 0.625833 0.625833 0 0 0 0.000833333 -1.16167">
                <PathIcon.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetName="AIIcon"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0" To="0.4" Duration="0:0:0.75" 
                                    RepeatBehavior="Forever" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </PathIcon.Triggers>
            </PathIcon>

            <TextBlock
                Grid.Column="1"
                FontSize="15"
                FontWeight="SemiBold"
                Text="AI"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="3"
                Width="28" Height="28"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="6"
                Click="Close_Click"
                ToolTipService.ToolTip="Close AI Panel">
                <PathIcon Data="F1 M 7.48333 1.92778 a 0.416667 0.416667 0 1 1 0.588889 0.588889 L 5.58889 5 l 2.48333 2.48333 a 0.416667 0.416667 0 1 1 -0.588889 0.588889 L 5 5.58889 l -2.48333 2.48333 a 0.416667 0.416667 0 0 1 -0.588889 -0.588889 L 4.41111 5 1.92778 2.51667 a 0.416667 0.416667 0 1 1 0.588889 -0.588889 L 5 4.41111 z" Width="10" Height="10" />
            </Button>
        </Grid>

        <!-- Separator -->
        <Border
            Grid.Row="1"
            Height="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.6" />

        <!-- Chat messages area -->
        <ScrollViewer
            Grid.Row="2"
            Padding="14,14"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ask me anything about this page"
                    TextAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- Input area -->
        <Grid Grid.Row="3" Padding="14,8,14,14">
            <TextBox
                PlaceholderText="Ask AI…"
                CornerRadius="8" />
        </Grid>
    </Grid>
</UserControl>
