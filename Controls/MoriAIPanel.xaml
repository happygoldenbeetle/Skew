<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mori.Controls.MoriAIPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="360">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="14,12" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Margin="0,0,8,0"
                FontSize="15"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xE945;" />

            <TextBlock
                Grid.Column="1"
                FontSize="15"
                FontWeight="SemiBold"
                Text="AI"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="3"
                Width="28" Height="28"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="6"
                Click="Close_Click"
                ToolTipService.ToolTip="Close AI Panel">
                <FontIcon FontSize="10" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- Separator -->
        <Border
            Grid.Row="1"
            Height="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.6" />

        <!-- Chat messages area -->
        <ScrollViewer
            Grid.Row="2"
            Padding="14,14"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ask me anything about this page"
                    TextAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- Input area -->
        <Grid Grid.Row="3" Padding="14,8,14,14">
            <TextBox
                PlaceholderText="Ask AI…"
                CornerRadius="8" />
        </Grid>
    </Grid>
</UserControl>
